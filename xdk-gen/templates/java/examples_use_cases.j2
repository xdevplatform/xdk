    /**
     * 9. Webhooks, Account Activity, Activity Subscriptions, Bots, Connections &amp; Account.
     */
    public static void runWebhooksAndAutomationExamples(XClient client) {
        // Webhooks
        client.webhooks()
                .create(
                        new Schemas.CreateWebhooksRequest()
                                .url("https://webhooks.example.org/x/events"));
        client.webhooks().get();
        client.webhooks().validate("wh_1");
        client.webhooks().createStreamLink("wh_1");
        client.webhooks().getStreamLinks();
        client.webhooks()
                .createWebhookReplayJob(
                        new Schemas.CreateWebhookReplayJobRequest()
                                .webhookId("wh_1")
                                .fromDate("202501150000")
                                .toDate("202501150100"));

        // Account Activity & X Activity Subscriptions
        client.accountActivity()
                .createSubscription("wh_1", new Schemas.CreateAccountActivitySubscriptionRequest());
        client.accountActivity().getSubscriptions("wh_1");
        client.accountActivity().getSubscriptionCount();
        client.accountActivity().validateSubscription("wh_1");
        client.accountActivity().deleteSubscription("wh_1", "2244994945");

        client.activity()
                .createSubscription(
                        new Schemas.CreateActivitySubscriptionRequest()
                                .eventType("post.create")
                                .webhookId("wh_1")
                                .tag("acct-sub"));
        client.activity().getSubscriptions();
        client.activity()
                .updateSubscription(
                        "sub_1", new Schemas.UpdateActivitySubscriptionRequest().tag("updated-tag"));
        client.activity().deleteSubscription("sub_1");
        client.webhooks().delete("wh_1");

        // Bots, Connections & Developer Account
        client.bots()
                .createBot(
                        new Schemas.CreateBotRequest()
                                .displayName("XDK Helper Bot")
                                .handle("xdk_helper_bot"));
        client.bots().get();
        client.bots().rotateBotToken("bot_1", new Schemas.RotateBotTokenRequest());
        client.bots().revokeBotToken("bot_1");
        client.bots().deleteBot("bot_1");

        client.connections().getConnectionHistory();
        client.connections().deleteByEndpoint("posts-stream");
        client.account().getDeveloper();
        client.account().ensure(new Schemas.EnsureAccountRequest().metadata("{}"));
    }

    /**
     * 10. Batch Compliance, API Usage &amp; OpenAPI Spec Introspection.
     */
    public static void runComplianceAndUsageExamples(XClient client) {
        // Batch Compliance job + binary upload & download
        client.compliance()
                .createJobs(
                        new Schemas.CreateComplianceJobsRequest()
                                .type("tweets")
                                .name("nightly-compliance-sync")
                                .resumable(true));
        client.compliance().getJobs("tweets", ComplianceClient.GetJobsOptions.builder().status("in_progress"));
        byte[] idsPayload = "1234567890\n1234567891\n".getBytes(StandardCharsets.UTF_8);
        client.compliance().uploadJobSubmission("job_1", "upload_tok", idsPayload);
        client.compliance().getJobsById("job_1");
        byte[] results = client.compliance().downloadJobResults("job_1", "download_tok");
        require(results != null && results.length > 0, "Compliance binary download");
        client.compliance().deleteJobsById("job_1");

        // API Usage & Credits
        client.usage().get(UsageClient.GetOptions.builder().days(7));
        client.usage().getCredits();

        // Live OpenAPI Spec Introspection
        JsonNode spec = client.general().getOpenApiSpec();
        require(spec != null && spec.size() > 0, "OpenAPI spec node");
    }

    /**
     * Runs all 10 X API v2 workflow suites (covering all 24 endpoint groups) and returns per-suite
     * execution durations in milliseconds.
     */
    public static Map<String, Long> runAll(String baseUrl, XClient client) {
        Map<String, Runnable> suites = new LinkedHashMap<>();
        suites.put("01_authentication_flows", () -> runAuthenticationExamples(baseUrl));
        suites.put("02_posts_and_search", () -> runPostsAndSearchExamples(client));
        suites.put("03_users_social_and_bookmarks", () -> runUsersAndBookmarksExamples(client));
        suites.put("04_realtime_streaming", () -> runStreamingExamples(client));
        suites.put("05_media_upload_and_metadata", () -> runMediaUploadExamples(client));
        suites.put("06_direct_messages_and_xchat", () -> runDirectMessagesAndChatExamples(client));
        suites.put("07_lists_communities_spaces_calls", () -> runCommunitiesSpacesListsExamples(client));
        suites.put("08_trends_news_articles_notes", () -> runDiscoveryAndNotesExamples(client));
        suites.put("09_webhooks_activity_bots_account", () -> runWebhooksAndAutomationExamples(client));
        suites.put("10_compliance_usage_and_openapi", () -> runComplianceAndUsageExamples(client));

        Map<String, Long> timings = new LinkedHashMap<>();
        for (Map.Entry<String, Runnable> entry : suites.entrySet()) {
            long start = System.nanoTime();
            entry.getValue().run();
            timings.put(entry.getKey(), (System.nanoTime() - start) / 1_000_000L);
        }
        return timings;
    }

    public static void main(String[] args) {
        String envBase = System.getenv("X_API_BASE_URL");
        String envBearer = System.getenv("X_BEARER_TOKEN");
        if (envBearer != null && !envBearer.isEmpty()) {
            String liveBase = (envBase != null && !envBase.isEmpty()) ? envBase : "https://api.x.com";
            XClient liveClient =
                    XClient.builder().baseUrl(liveBase).bearerToken(envBearer).build();
            Schemas.GetUsersByUsernameResponse user =
                    liveClient.users().getByUsername("XDevelopers");
            System.out.println("Live lookup @XDevelopers -> " + user.getData());
            return;
        }

        try (MockXApiServer simulator = new MockXApiServer()) {
            XClient client =
                    XClient.builder()
                            .baseUrl(simulator.getBaseUrl())
                            .bearerToken("sim-bearer")
                            .accessToken("sim-oauth2")
                            .oauth1(new OAuth1("ck", "cs", "oob", "at", "ats"))
                            .build();
            Map<String, Long> results = runAll(simulator.getBaseUrl(), client);
            System.out.println("=== XDK Java Use-Case Examples Completed (" + results.size() + " suites) ===");
            results.forEach((name, ms) -> System.out.println("  [PASS] " + name + " (" + ms + " ms)"));
        }
    }

    private static void require(boolean condition, String message) {
        if (!condition) {
            throw new IllegalStateException("Example assertion failed: " + message);
        }
    }
}
