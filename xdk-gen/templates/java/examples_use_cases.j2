    private UseCaseExamples() {}

    /**
     * 1. Authentication Flows: Bearer Token, OAuth 2.0 PKCE + Refresh, and OAuth 1.0a User Context.
     */
    public static void runAuthenticationExamples(String baseUrl) {
        // 1a. App-Only Bearer Token
        XClient bearerClient =
                XClient.builder()
                        .baseUrl(baseUrl)
                        .bearerToken("app_only_bearer_token")
                        .build();
        Schemas.GetUsersByUsernameResponse appLookup =
                bearerClient.users().getByUsername("XDevelopers");
        require(appLookup != null && appLookup.getData() != null, "Bearer lookup should return data");

        // 1b. OAuth 2.0 Authorization Code with PKCE + Token Refresh
        OAuth2Pkce oauth2 =
                new OAuth2Pkce(
                        "demo_client_id",
                        "demo_client_secret",
                        "https://example.org/oauth/callback",
                        Arrays.asList("tweet.read", "tweet.write", "users.read", "offline.access"),
                        baseUrl,
                        "https://x.com/i",
                        null);
        XClient oauth2Client = XClient.builder().baseUrl(baseUrl).oauth2(oauth2).build();
        String authorizationUrl = oauth2.getAuthorizationUrl("state_token_abc");
        require(authorizationUrl.contains("code_challenge_method=S256"), "PKCE S256 URL expected");
        OAuth2Token token = oauth2.exchangeCode("sample_auth_code");
        require(token.getAccessToken() != null, "Exchanged access token expected");
        Schemas.GetUsersMeResponse me = oauth2Client.users().getMe();
        require(me != null && me.getData() != null, "OAuth2 getMe should succeed");
        oauth2Client.refreshToken();

        // 1c. OAuth 1.0a User Context (HMAC-SHA1)
        OAuth1 oauth1 =
                new OAuth1(
                        "consumer_key",
                        "consumer_secret",
                        "oob",
                        "user_access_token",
                        "user_access_secret");
        XClient oauth1Client = XClient.builder().baseUrl(baseUrl).oauth1(oauth1).build();
        Schemas.CreatePostsResponse created =
                oauth1Client
                        .posts()
                        .create(new Schemas.CreatePostsRequest().text("Posting with OAuth 1.0a!"));
        require(created != null, "OAuth1 post creation should succeed");
    }

    /**
     * 2. Posts, Search, Post Counts &amp; Analytics ({@code PostsClient}).
     */
    public static void runPostsAndSearchExamples(XClient client) {
        // Create a post, reply, and quote
        Schemas.CreatePostsResponse created =
                client.posts()
                        .create(
                                new Schemas.CreatePostsRequest()
                                        .text("Shipping Java & C# SDKs on X API v2!")
                                        .replySettings("everyone"));
        require(created != null, "create post");

        // Single & batch post lookup with fields and expansions
        PostsClient.GetByIdOptions lookupOpts =
                PostsClient.GetByIdOptions.builder()
                        .postFields(Arrays.asList("created_at", "public_metrics", "author_id"))
                        .expansions(Collections.singletonList("author_id"))
                        .userFields(Arrays.asList("username", "verified"));
        Schemas.GetPostsByIdResponse post = client.posts().getById("1234567890", lookupOpts);
        require(post != null, "getById");
        client.posts().getByIds(Arrays.asList("1234567890", "1234567891"));

        // Paginated recent search & full-archive search
        Paginator<Schemas.SearchPostsRecentResponse> pages =
                client.posts()
                        .searchRecentPages(
                                "from:XDevelopers -is:retweet",
                                PostsClient.SearchRecentOptions.builder().maxResults(10));
        int pageCount = 0;
        for (Schemas.SearchPostsRecentResponse page : pages) {
            require(page != null, "search page");
            if (++pageCount >= 2) break;
        }
        client.posts().searchAll("xdk sdk", PostsClient.SearchAllOptions.builder().maxResults(10));

        // Post counts, analytics & engagement lookups
        client.posts()
                .getCountsRecent(
                        "xdk",
                        PostsClient.GetCountsRecentOptions.builder().granularity("day"));
        client.posts().getCountsAll("xdk");
        client.posts()
                .getAnalytics(
                        Collections.singletonList("1234567890"),
                        "2025-01-01T00:00:00Z",
                        "2025-01-07T00:00:00Z");
        client.posts().getLikingUsers("1234567890");
        client.posts().getRepostedBy("1234567890");
        client.posts().getQuoted("1234567890");
        client.posts().hideReply("1234567890", new Schemas.HidePostsReplyRequest().hidden(true));
        client.posts().delete("1234567890");
    }

    /**
     * 3. Users, Timelines, Social Graph &amp; Bookmarks ({@code UsersClient}).
     */
    public static void runUsersAndBookmarksExamples(XClient client) {
        // Profile lookups & user search
        Schemas.GetUsersMeResponse me =
                client.users()
                        .getMe(
                                UsersClient.GetMeOptions.builder()
                                        .userFields(Arrays.asList("created_at", "description")));
        String myId = me.getData() != null && me.getData().getId() != null ? me.getData().getId() : "2244994945";
        client.users().getByUsername("XDevelopers");
        client.users().getByUsernames(Arrays.asList("XDevelopers", "X"));
        client.users().getById(myId);
        client.users().getByIds(Arrays.asList(myId, "783214"));
        client.users().search("developer platform");

        // Timelines & mentions with cursor pagination
        int timelinePages = 0;
        for (Schemas.GetUsersPostsResponse page :
                client.users()
                        .getPostsPages(myId, UsersClient.GetPostsOptions.builder().maxResults(10))) {
            require(page != null, "user posts page");
            if (++timelinePages >= 2) break;
        }
        client.users().getMentions(myId);
        client.users().getTimeline(myId);

        // Social graph: follow, followers, likes, reposts, blocks, mutes
        client.users().followUser(myId, new Schemas.FollowUserRequest().targetUserId("783214"));
        for (Schemas.GetUsersFollowersResponse followersPage :
                client.users().getFollowersPages(myId)) {
            require(followersPage != null, "followers page");
            break;
        }
        client.users().getFollowing(myId);
        client.users().likePost(myId, new Schemas.LikePostRequest().tweetId("1234567890"));
        client.users().unlikePost(myId, "1234567890");
        client.users().repostPost(myId, new Schemas.RepostPostRequest().tweetId("1234567890"));
        client.users().unrepostPost(myId, "1234567890");
        client.users().idBlock(myId, new Schemas.UsersIdBlockRequest().targetUserId("99999"));
        client.users().idUnblock(myId, "99999");
        client.users().muteUser(myId, new Schemas.MuteUserRequest().targetUserId("99999"));
        client.users().unmuteUser(myId, "99999");
        client.users().unfollowUser(myId, "783214");

        // Bookmarks & bookmark folders
        JsonNode bookmarked =
                client.users()
                        .createBookmark(
                                myId,
                                new Schemas.CreateUsersBookmarkRequest().tweetId("1234567890"));
        require(bookmarked != null, "createBookmark");
        for (Schemas.GetUsersBookmarksResponse bmPage : client.users().getBookmarksPages(myId)) {
            require(bmPage != null, "bookmarks page");
            break;
        }
        client.users()
                .createBookmarkFolder(
                        myId, new Schemas.CreateUsersBookmarkFolderRequest().name("SDK Docs"));
        client.users().getBookmarkFolders(myId);
        client.users().deleteBookmark(myId, "1234567890");
    }

    /**
     * 4. Real-Time Filtered &amp; Sample Streaming ({@code StreamClient}).
     */
    public static void runStreamingExamples(XClient client) {
        // Configure filtered stream rules
        Schemas.UpdateRulesAdd rule =
                new Schemas.UpdateRulesAdd().value("xdk (java OR csharp) -is:retweet").tag("xdk-mentions");
        client.stream()
                .updateRules(new Schemas.UpdateRulesRequest().add(Collections.singletonList(rule)));
        client.stream().getRules();
        client.stream().getRuleCounts();

        // Consume real-time filtered stream with resilient StreamConfig
        StreamConfig streamCfg =
                StreamConfig.builder()
                        .maxRetries(2)
                        .initialBackoff(java.time.Duration.ofMillis(25))
                        .maxBackoff(java.time.Duration.ofMillis(100))
                        .build();
        List<Schemas.StreamPostsResponse> events = new ArrayList<>();
        try (EventStream<Schemas.StreamPostsResponse> stream =
                client.stream()
                        .posts(
                                StreamClient.PostsOptions.builder()
                                        .tweetFields(Arrays.asList("created_at", "author_id"))
                                        .streamConfig(streamCfg))) {
            for (Schemas.StreamPostsResponse ev : stream) {
                events.add(ev);
                if (events.size() >= 2) break;
            }
        }
        require(!events.isEmpty(), "Filtered stream should emit events");

        // Consume 1% sample stream
        try (EventStream<Schemas.StreamPostsSampleResponse> sample =
                client.stream()
                        .postsSample(
                                StreamClient.PostsSampleOptions.builder().streamConfig(streamCfg))) {
            var it = sample.iterator();
            require(it.hasNext() && it.next() != null, "Sample stream should emit event");
        }
    }

    /**
     * 5. Media Upload, Chunked Large Video &amp; Metadata ({@code MediaClient}).
     */
    public static void runMediaUploadExamples(XClient client) {
        String base64Chunk =
                Base64.getEncoder()
                        .encodeToString("fake_mp4_segment_bytes".getBytes(StandardCharsets.UTF_8));

        // Single-shot upload
        client.media()
                .upload(
                        new Schemas.MediaUploadRequest()
                                .media(base64Chunk)
                                .mediaCategory("tweet_image"));

        // Chunked video upload lifecycle (supports >2 GiB 64-bit totalBytes!)
        Schemas.InitializeMediaUploadResponse init =
                client.media()
                        .initializeUpload(
                                new Schemas.InitializeMediaUploadRequest()
                                        .totalBytes(3_221_225_472L) // 3 GiB
                                        .mediaType("video/mp4")
                                        .mediaCategory("tweet_video"));
        String mediaId =
                init.getData() != null && init.getData().getId() != null
                        ? init.getData().getId()
                        : "1889990001";
        client.media()
                .appendUpload(
                        mediaId,
                        new Schemas.AppendMediaUploadRequest().segmentIndex(0).media(base64Chunk));
        client.media().finalizeUpload(mediaId);
        client.media()
                .getUploadStatus(
                        mediaId, MediaClient.GetUploadStatusOptions.builder().command("STATUS"));

        // Accessibility alt-text metadata, subtitles, lookup & analytics
        client.media().createMetadata(new Schemas.CreateMediaMetadataRequest().id(mediaId));
        client.media()
                .createSubtitles(
                        new Schemas.CreateMediaSubtitlesRequest()
                                .id(mediaId)
                                .mediaCategory("tweet_video"));
        client.media().getByKeys(Collections.singletonList("3_" + mediaId));
        client.media()
                .getAnalytics(
                        Collections.singletonList("3_" + mediaId),
                        "2025-01-01T00:00:00Z",
                        "2025-01-07T00:00:00Z");
        client.media().getLibraryCategories();
    }

    /**
     * 6. Direct Messages &amp; Encrypted XChat ({@code DirectMessagesClient}, {@code ChatClient}).
     */
    public static void runDirectMessagesAndChatExamples(XClient client) {
        // Direct Messages v2
        client.directMessages()
                .createByParticipantId(
                        "783214",
                        new Schemas.CreateDirectMessagesByParticipantIdRequest()
                                .text("Hey from XDK Java!"));
        client.directMessages()
                .createConversation(
                        new Schemas.CreateDirectMessagesConversationRequest()
                                .conversationType("Group")
                                .participantIds(Arrays.asList("783214", "2244994945")));
        client.directMessages()
                .createByConversationId(
                        "conv_1",
                        new Schemas.CreateDirectMessagesByConversationIdRequest()
                                .text("Welcome to the group DM!"));
        for (Schemas.GetDirectMessagesEventsResponse dmPage :
                client.directMessages()
                        .getEventsPages(
                                DirectMessagesClient.GetEventsOptions.builder().maxResults(10))) {
            require(dmPage != null, "DM events page");
            break;
        }
        byte[] dmMedia = client.directMessages().dmConversationsMediaDownload("dm_1", "m_1", "r_1");
        require(dmMedia.length > 0, "DM media binary download");
        client.directMessages().deleteEvents("ev_1");

        // Encrypted XChat & public keys
        client.users().getPublicKeys(Collections.singletonList("2244994945"));
        client.chat().getSettings();
        client.chat()
                .sendMessage(
                        "chat_conv_1",
                        new Schemas.SendChatMessageRequest()
                                .encodedMessageCreateEvent("base64_encrypted_event")
                                .messageId("msg_001"));
        client.chat().getConversationEvents("chat_conv_1");
        client.chat()
                .mediaUploadInitialize(
                        new Schemas.ChatMediaUploadInitializeRequest()
                                .conversationId("chat_conv_1")
                                .totalBytes(1048576L));
        client.chat()
                .mediaUploadAppend(
                        "upload_1",
                        new Schemas.ChatMediaUploadAppendRequest()
                                .conversationId("chat_conv_1")
                                .mediaHashKey("hash_1")
                                .segmentIndex(0)
                                .media("Y2hhdF9tZWRpYQ=="));
        byte[] chatBytes = client.chat().mediaDownload("chat_conv_1", "hash_1");
        require(chatBytes.length > 0, "XChat media download");
    }

    /**
     * 7. Lists, Communities, Spaces, Broadcasts &amp; Calls.
     */
    public static void runCommunitiesSpacesListsExamples(XClient client) {
        // Lists
        Schemas.CreateListsResponse list =
                client.lists()
                        .create(
                                new Schemas.CreateListsRequest()
                                        .name("XDK Contributors")
                                        .description("Core SDK builders")
                                        .privateValue(false));
        require(list != null, "create list");
        client.lists().getById("list_1");
        client.lists().addMember("list_1", new Schemas.AddListsMemberRequest().userId("783214"));
        client.lists().getMembers("list_1");
        for (Schemas.GetListsPostsResponse lp :
                client.lists()
                        .getPostsPages("list_1", ListsClient.GetPostsOptions.builder().maxResults(10))) {
            require(lp != null, "list posts page");
            break;
        }
        client.lists().update("list_1", new Schemas.UpdateListsRequest().description("Updated"));
        client.lists().removeMemberByUserId("list_1", "783214");
        client.lists().delete("list_1");

        // Communities & Spaces
        client.communities().search("X Developers");
        client.communities().getById("comm_1");
        client.spaces().search("AI Engineering", SpacesClient.SearchOptions.builder().state("live"));
        client.spaces().getById("1YqKDqWLPPlKV");
        client.spaces().getByCreatorIds(Collections.singletonList("2244994945"));
        client.spaces().getPosts("1YqKDqWLPPlKV");

        // Broadcasts & Calls
        client.broadcasts().getRegion();
        client.broadcasts().list();
        client.broadcasts().listSources();
        client.calls()
                .createCall(
                        new Schemas.CreateCallRequest()
                                .conversationId("chat_conv_1")
                                .audioOnly(true)
                                .title("SDK Standup"));
        client.calls().getCall("call_1");
        client.calls().listScheduled();
        client.calls().leaveCall("call_1");
    }

