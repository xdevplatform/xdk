    public String getAccessToken() {
        if (accessToken != null && !accessToken.isEmpty()) {
            return accessToken;
        }
        if (oauth2 != null && oauth2.getToken() != null) {
            return oauth2.getToken().getAccessToken();
        }
        return null;
