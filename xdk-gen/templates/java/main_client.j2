    public XClient(XClientConfig config) {
        XClientConfig cfg = config != null ? config : XClientConfig.builder().build();
        String rawBase = cfg.getBaseUrl() != null ? cfg.getBaseUrl() : "https://api.x.com";
        this.baseUrl =
                rawBase.endsWith("/") ? rawBase.substring(0, rawBase.length() - 1) : rawBase;
        this.bearerToken = cfg.getBearerToken();
        this.oauth2 = cfg.getOauth2();
        this.accessToken = cfg.getAccessToken();
        this.oauth1 = cfg.getOauth1();
        this.defaultHeaders = new LinkedHashMap<>();
        this.defaultHeaders.put("User-Agent", USER_AGENT);
        this.defaultHeaders.put("Accept", "application/json");
        this.defaultHeaders.putAll(cfg.getHeaders());
        this.timeout = cfg.getTimeout();
        this.retry = cfg.isRetry();
        this.maxRetries = Math.max(0, cfg.getMaxRetries());
        this.transport =
                cfg.getTransport() != null ? cfg.getTransport() : new JdkHttpTransport();
        this.objectMapper =
                new ObjectMapper()
                        .registerModule(new JavaTimeModule())
                        .configure(DeserializationFeature.FAIL_ON_UNKNOWN_PROPERTIES, false);

