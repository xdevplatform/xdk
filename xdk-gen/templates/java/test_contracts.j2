package com.xdevplatform.xdk;

import static org.junit.jupiter.api.Assertions.*;

import com.xdevplatform.xdk.auth.OAuth1;
import com.xdevplatform.xdk.http.HttpTransport;
import java.io.ByteArrayInputStream;
import java.io.InputStream;
import java.nio.charset.StandardCharsets;
import java.util.Arrays;
import java.util.Collections;
import java.util.concurrent.atomic.AtomicReference;
import org.junit.jupiter.api.Test;

public class {{ tag.class_name }}ContractsTest {
    {% for contract_test in test_spec.contract_tests %}
    @Test
    void contract_{{ contract_test.method_name | java_ident }}() {
        AtomicReference<HttpTransport.TransportRequest> captured = new AtomicReference<>();
        String mockJson = {{ contract_test.response_schema.mock_json | java_string_literal }};
        HttpTransport mockTransport =
                new HttpTransport() {
                    @Override
                    public TransportResponse send(TransportRequest request) {
                        captured.set(request);
                        return new TransportResponse(
                                {{ contract_test.response_schema.status_code }},
                                Collections.singletonMap(
                                        "content-type", Collections.singletonList("application/json")),
                                mockJson.getBytes(StandardCharsets.UTF_8));
                    }

                    @Override
                    public InputStream sendStream(TransportRequest request) {
                        captured.set(request);
                        byte[] ndjson = (mockJson + "\n").getBytes(StandardCharsets.UTF_8);
                        return new ByteArrayInputStream(ndjson);
                    }
                };

        XClient client =
                XClient.builder()
                        .baseUrl("https://api.example.com")
                        .bearerToken("test-bearer")
                        .accessToken("test-access")
                        .oauth1(new OAuth1("ck", "cs", "oob", "at", "ats"))
                        .transport(mockTransport)
                        .build();

        {% set call_args = namespace(first=true, code="") %}
        {% for param in contract_test.required_params %}
        {% set arg_expr %}{% if param.param_type == "integer" %}1{% elif param.param_type == "number" %}1.0{% elif param.param_type == "boolean" %}true{% elif param.param_type == "array" %}Arrays.asList("item1"){% else %}"test_{{ param.variable_name }}"{% endif %}{% endset %}
        {% if not call_args.first %}{% set call_args.code = call_args.code ~ ", " %}{% endif %}
        {% set call_args.first = false %}
        {% set call_args.code = call_args.code ~ arg_expr %}
        {% endfor %}
        {% if contract_test.request_body_schema and contract_test.request_body_schema.required %}
        {% set body_expr %}{% if contract_test.has_request_model %}null{% else %}"payload".getBytes(StandardCharsets.UTF_8){% endif %}{% endset %}
        {% if not call_args.first %}{% set call_args.code = call_args.code ~ ", " %}{% endif %}
        {% set call_args.first = false %}
        {% set call_args.code = call_args.code ~ body_expr %}
        {% endif %}

        Object result =
                client.{{ tag.property_name | java_ident }}()
                        .{{ contract_test.method_name | java_ident }}({{ call_args.code }});
        assertNotNull(result);

        {% if contract_test.is_streaming %}
        if (result instanceof Iterable<?>) {
            var it = ((Iterable<?>) result).iterator();
            if (it.hasNext()) {
                assertNotNull(it.next());
            }
        }
        {% endif %}

        assertNotNull(captured.get(), "HTTP transport should receive request");
        assertEquals("{{ contract_test.method | upper }}", captured.get().getMethod());
        String baseSegment = "{{ contract_test.path | path_prefix }}";
        assertTrue(
                captured.get().getUrl().contains(baseSegment),
                "Expected URL to contain " + baseSegment + " but got " + captured.get().getUrl());
    }
    {% endfor %}
}
