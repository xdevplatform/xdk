import static org.junit.jupiter.api.Assertions.*;

import com.fasterxml.jackson.core.type.TypeReference;
import com.xdevplatform.xdk.auth.OAuth1;
import com.xdevplatform.xdk.clients.{{ tag.class_name }}Client;
import com.xdevplatform.xdk.models.Schemas;
