/**
 * Full-coverage TCP loopback contract &amp; schema round-trip tests for {@link {{ tag.class_name }}Client}.
 *
 * <p>Exercises the real {@code JdkHttpTransport} over a local TCP {@link MockXApiServer} for every
 * operation in this tag, verifying typed request serialization, optional query/header builders,
 * authentication headers, HTTP status codes, and populated response model deserialization +
 * re-serialization round-trips.
 */
public class {{ tag.class_name }}ContractsTest {
    private static MockXApiServer server;
    private static XClient client;

    @BeforeAll
    static void startLoopbackServer() {
        server = new MockXApiServer();
        client =
                XClient.builder()
                        .baseUrl(server.getBaseUrl())
                        .bearerToken("test-bearer-token")
                        .accessToken("test-oauth2-token")
                        .oauth1(new OAuth1("ck", "cs", "oob", "at", "ats"))
                        .retry(false)
                        .build();
    }

    @AfterAll
    static void stopLoopbackServer() {
        if (server != null) {
            server.close();
        }
    }

    @BeforeEach
    void resetServer() {
        server.reset();
    }

    {% for contract_test in test_spec.contract_tests %}
    @Test
    void contract_{{ contract_test.method_name | java_ident }}() throws Exception {
        String mockJson = {{ contract_test.full_response_mock_json | java_string_literal }};
        {% if contract_test.is_streaming %}
        server.setResponder(
                req ->
                        MockXApiServer.MockResponse.chunkedStream(
                                Arrays.asList(
                                        "{}\r\n".getBytes(StandardCharsets.UTF_8),
                                        (mockJson + "\n").getBytes(StandardCharsets.UTF_8)),
                                false));
        {% elif contract_test.is_binary_response %}
        byte[] expectedBinary = new byte[] {0x00, 0x01, 0x58, 0x44, 0x4B, (byte) 0xFF};
        server.setResponder(
                req ->
                        MockXApiServer.MockResponse.bytes(
                                {{ contract_test.response_schema.status_code }},
                                "application/octet-stream",
                                expectedBinary));
        {% else %}
        server.setResponder(
                req ->
                        MockXApiServer.MockResponse.json(
                                {{ contract_test.response_schema.status_code }}, mockJson));
        {% endif %}

        {% if contract_test.required_body %}
        {% if contract_test.has_request_model and contract_test.request_mock_json %}
        String reqMockJson = {{ contract_test.request_mock_json | java_string_literal }};
        {{ contract_test.request_java_type }} reqBody =
                client.getObjectMapper()
                        .readValue(
                                reqMockJson,
                                new TypeReference<{{ contract_test.request_java_type }}>() {});
        {% elif contract_test.is_binary_request %}
        byte[] reqBody = "binary_submission_payload".getBytes(StandardCharsets.UTF_8);
        {% else %}
        Object reqBody = Collections.singletonMap("key", "value");
        {% endif %}
        {% endif %}

        {% if contract_test.has_options %}
        {{ tag.class_name }}Client.{{ contract_test.class_name }}Options options =
                {{ tag.class_name }}Client.{{ contract_test.class_name }}Options.builder()
                        .header("X-Contract-Operation", "{{ contract_test.method_name }}");
        {% for opt in contract_test.optional_params %}
        {% if loop.index <= 2 %}
        {% set opt_val %}{% if opt.param_type == "integer" %}10{% elif opt.param_type == "number" %}1.5{% elif opt.param_type == "boolean" %}true{% elif opt.param_type == "array" %}Arrays.asList("id", "created_at"){% else %}"opt_{{ opt.variable_name }}"{% endif %}{% endset %}
        options.{{ opt.variable_name | java_ident }}({{ opt_val }});
        {% endif %}
        {% endfor %}
        {% if contract_test.is_streaming %}
        options.streamConfig(StreamConfig.builder().maxRetries(0).build());
        {% endif %}
        {% endif %}

        {% set call_args = namespace(first=true, code="") %}
        {% for param in contract_test.required_params %}
        {% set arg_expr %}{% if param.param_type == "integer" %}1{% elif param.param_type == "number" %}1.0{% elif param.param_type == "boolean" %}true{% elif param.param_type == "array" %}Arrays.asList("item1"){% else %}"test_{{ param.variable_name }}"{% endif %}{% endset %}
        {% if not call_args.first %}{% set call_args.code = call_args.code ~ ", " %}{% endif %}
        {% set call_args.first = false %}
        {% set call_args.code = call_args.code ~ arg_expr %}
        {% endfor %}
        {% if contract_test.required_body %}
        {% if not call_args.first %}{% set call_args.code = call_args.code ~ ", " %}{% endif %}
        {% set call_args.first = false %}
        {% set call_args.code = call_args.code ~ "reqBody" %}
        {% endif %}
        {% if contract_test.has_options %}
        {% if not call_args.first %}{% set call_args.code = call_args.code ~ ", " %}{% endif %}
        {% set call_args.first = false %}
        {% set call_args.code = call_args.code ~ "options" %}
        {% endif %}

        Object result =
                client.{{ tag.property_name | java_ident }}()
                        .{{ contract_test.method_name | java_ident }}({{ call_args.code }});
        assertNotNull(result);

        {% if contract_test.is_streaming %}
        try (AutoCloseable closeable = (AutoCloseable) result) {
            var it = ((Iterable<?>) result).iterator();
            assertTrue(it.hasNext(), "Expected streaming iterator to yield item");
            Object streamedItem = it.next();
            assertNotNull(streamedItem);
            String roundTrip = client.getObjectMapper().writeValueAsString(streamedItem);
            assertNotNull(roundTrip);
        }
        {% elif contract_test.is_binary_response %}
        assertArrayEquals(expectedBinary, (byte[]) result);
        {% else %}
        String roundTripJson = client.getObjectMapper().writeValueAsString(result);
        assertNotNull(roundTripJson);
        assertFalse(roundTripJson.isEmpty());
        {% endif %}

        MockXApiServer.RecordedRequest captured = server.lastRequest();
        assertNotNull(captured, "Loopback HTTP server should receive request");
        assertEquals("{{ contract_test.method | upper }}", captured.getMethod());
        String baseSegment = "{{ contract_test.path | path_prefix }}";
        assertTrue(
                captured.getPath().contains(baseSegment),
                "Expected path to contain " + baseSegment + " but got " + captured.getPath());
        {% if contract_test.has_options %}
        assertEquals("{{ contract_test.method_name }}", captured.firstHeader("x-contract-operation"));
        {% endif %}
        {% if contract_test.security_requirements | length > 0 %}
        assertNotNull(captured.firstHeader("authorization"), "Expected Authorization header");
        {% endif %}
        {% if contract_test.required_body %}
        assertTrue(captured.getBodyBytes().length > 0, "Expected non-empty request body");
        {% if contract_test.has_request_model %}
        assertNotNull(client.getObjectMapper().readTree(captured.getBodyBytes()));
        {% endif %}
        {% endif %}
    }
    {% endfor %}
}
