namespace Xdk.Tests;

public class XClientCoreTests
{
    [Fact]
    public void QueryParamBooleanAndArraySerialization()
    {
        var query = new Dictionary<string, string>();
        XClient.AddQueryParam(query, "dry_run", true);
        XClient.AddQueryParam(query, "delete_all", false);
        XClient.AddQueryParam(query, "tweet.fields", new[] { "id", "text", "created_at" });

        Assert.Equal("true", query["dry_run"]);
        Assert.Equal("false", query["delete_all"]);
        Assert.Equal("id,text,created_at", query["tweet.fields"]);
    }

    [Fact]
    public void OAuth1SignsByteOrderedParametersPerRfc5849()
    {
        var oauth1 = new OAuth1("ck", "cs", "oob", "at", "ats");
        var header = oauth1.BuildRequestHeader(
            "GET",
            "https://api.x.com/2/media?media_keys=3_1&media.fields=url",
            "",
            "fixednonce",
            "1700000000");

        var baseString =
            "GET&https%3A%2F%2Fapi.x.com%2F2%2Fmedia&"
            + "media.fields%3Durl%26media_keys%3D3_1"
            + "%26oauth_consumer_key%3Dck"
            + "%26oauth_nonce%3Dfixednonce"
            + "%26oauth_signature_method%3DHMAC-SHA1"
            + "%26oauth_timestamp%3D1700000000"
            + "%26oauth_token%3Dat"
            + "%26oauth_version%3D1.0";
        var expectedSig = OAuth1.PercentEncode(OAuth1.HmacSha1Base64("cs&ats", baseString));
        Assert.Contains($"oauth_signature=\"{expectedSig}\"", header);
    }

    [Fact]
    public void PkceCodeVerifierRespectsRfc7636Bounds()
    {
        var regex = new Regex("^[A-Za-z0-9\\-._~]+$");
        foreach (var len in new[] { 43, 64, 96, 128 })
        {
            var verifier = OAuth2Pkce.GenerateCodeVerifier(len);
            Assert.Equal(len, verifier.Length);
            Assert.Matches(regex, verifier);
        }

        var pkce = new OAuth2Pkce("client-id", "https://example.com/cb");
        var url = pkce.GetAuthorizationUrl("st1");
        Assert.Contains("code_challenge=", url);
        Assert.Contains("code_challenge_method=S256", url);
        Assert.NotNull(pkce.CodeVerifier);
    }

    [Fact]
    public async Task RetriesTransient503WhenEnabled()
    {
        var hits = 0;
        var handler = new MockHttpMessageHandler(_ =>
        {
            hits++;
            if (hits == 1)
            {
                return new HttpResponseMessage(HttpStatusCode.ServiceUnavailable)
                {
                    Content = new StringContent("{\"title\":\"Service Unavailable\"}", Encoding.UTF8, "application/json"),
                };
            }
            return new HttpResponseMessage(HttpStatusCode.OK)
            {
                Content = new StringContent("{\"ok\":true}", Encoding.UTF8, "application/json"),
            };
        });

        using var httpClient = new HttpClient(handler);
        using var client = new XClient(new XClientOptions
        {
            BaseUrl = "https://api.example.com",
            BearerToken = "token",
            Retry = true,
            MaxRetries = 2,
            HttpClient = httpClient,
        });

        var res = await client.SendJsonAsync<JsonElement>(
            HttpMethod.Get,
            "/2/test",
            null,
            null,
            null,
            "application/json",
            new[] { "BearerToken" });

        Assert.Equal(2, hits);
        Assert.True(res.GetProperty("ok").GetBoolean());
    }

    [Fact]
    public async Task EventStreamHandlesSplitMultiByteUtf8AndKeepAlive()
    {
        var full = Encoding.UTF8.GetBytes("\n{}\n{\"data\":{\"id\":\"1\",\"text\":\"Bonjour 🚀 café\"}}\n");
        var chunked = new SmallChunkStream(full, 3);

        await using var stream = new EventStream<JsonElement>(
            _ => Task.FromResult<Stream>(chunked),
            new JsonSerializerOptions(),
            new StreamOptions { MaxRetries = 0 });

        var items = new List<JsonElement>();
        await foreach (var item in stream)
        {
            items.Add(item);
        }

        Assert.Single(items);
        Assert.Equal("Bonjour 🚀 café", items[0].GetProperty("data").GetProperty("text").GetString());
    }

    private sealed class SmallChunkStream : Stream
    {
        private readonly byte[] _data;
        private readonly int _maxChunk;
        private int _pos;

        public SmallChunkStream(byte[] data, int maxChunk)
        {
            _data = data;
            _maxChunk = maxChunk;
        }

        public override bool CanRead => true;
        public override bool CanSeek => false;
        public override bool CanWrite => false;
        public override long Length => _data.Length;
        public override long Position { get => _pos; set => throw new NotSupportedException(); }
        public override void Flush() { }
        public override long Seek(long offset, SeekOrigin origin) => throw new NotSupportedException();
        public override void SetLength(long value) => throw new NotSupportedException();
        public override void Write(byte[] buffer, int offset, int count) => throw new NotSupportedException();

        public override int Read(byte[] buffer, int offset, int count)
        {
            if (_pos >= _data.Length) return 0;
            var toCopy = Math.Min(_maxChunk, Math.Min(count, _data.Length - _pos));
            Array.Copy(_data, _pos, buffer, offset, toCopy);
            _pos += toCopy;
            return toCopy;
        }

        public override ValueTask<int> ReadAsync(Memory<byte> buffer, CancellationToken cancellationToken = default)
        {
            if (_pos >= _data.Length) return ValueTask.FromResult(0);
            var toCopy = Math.Min(_maxChunk, Math.Min(buffer.Length, _data.Length - _pos));
            _data.AsMemory(_pos, toCopy).CopyTo(buffer);
            _pos += toCopy;
            return ValueTask.FromResult(toCopy);
        }
    }
}
