    public XClient(XClientOptions? options = null)
    {
        var opts = options ?? new XClientOptions();
        BaseUrl = string.IsNullOrWhiteSpace(opts.BaseUrl)
            ? "https://api.x.com"
            : opts.BaseUrl.TrimEnd('/');
        BearerToken = opts.BearerToken;
        OAuth2 = opts.OAuth2;
        _accessToken = opts.AccessToken;
        OAuth1 = opts.OAuth1;
        Timeout = opts.Timeout;
        Retry = opts.Retry;
        MaxRetries = Math.Max(0, opts.MaxRetries);

        _defaultHeaders = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            ["User-Agent"] = UserAgent,
            ["Accept"] = "application/json",
        };
        foreach (var kv in opts.Headers)
        {
            _defaultHeaders[kv.Key] = kv.Value;
        }

        if (opts.HttpClient != null)
        {
            _httpClient = opts.HttpClient;
            _disposeHttpClient = false;
        }
        else
        {
            _httpClient = new HttpClient { Timeout = System.Threading.Timeout.InfiniteTimeSpan };
            _disposeHttpClient = true;
        }

        JsonOptions = new JsonSerializerOptions
        {
            DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull,
            PropertyNameCaseInsensitive = false,
            NumberHandling = JsonNumberHandling.AllowReadingFromString,
        };

