namespace Xdk;

/// <summary>
/// Primary C# / .NET client for interacting with the X API v2.
/// </summary>
public sealed class XClient : IDisposable
{
    public const string Version = "{{ version }}";
    public const string UserAgent = "xdk-csharp/{{ version }}";

    private static readonly HashSet<int> RetryableStatusCodes = new() { 429, 500, 502, 503, 504 };

    private readonly HttpClient _httpClient;
    private readonly bool _disposeHttpClient;
    private readonly Dictionary<string, string> _defaultHeaders;
    private string? _accessToken;

    public string BaseUrl { get; }
    public string? BearerToken { get; }
    public OAuth2Pkce? OAuth2 { get; }
    public OAuth1? OAuth1 { get; }
    public TimeSpan Timeout { get; }
    public bool Retry { get; }
    public int MaxRetries { get; }
    public JsonSerializerOptions JsonOptions { get; }

