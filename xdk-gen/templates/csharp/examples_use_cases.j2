    /// <summary>
    /// 10. Batch Compliance, API Usage &amp; OpenAPI Spec Introspection.
    /// </summary>
    public static async Task RunComplianceAndUsageExamplesAsync(XClient client, CancellationToken ct = default)
    {
        await client.Compliance.CreateJobsAsync(new CreateComplianceJobsRequest
        {
            Type = "tweets",
            Name = "nightly-compliance-sync",
            Resumable = true,
        }, cancellationToken: ct);
        await client.Compliance.GetJobsAsync("tweets", new ComplianceClient.GetJobsOptions { Status = "in_progress" }, ct);
        var idsPayload = Encoding.UTF8.GetBytes("1234567890\n1234567891\n");
        await client.Compliance.UploadJobSubmissionAsync("job_1", "upload_tok", idsPayload, cancellationToken: ct);
        await client.Compliance.GetJobsByIdAsync("job_1", cancellationToken: ct);
        var results = await client.Compliance.DownloadJobResultsAsync("job_1", "download_tok", cancellationToken: ct);
        Require(results.Length > 0, "Compliance binary download");
        await client.Compliance.DeleteJobsByIdAsync("job_1", cancellationToken: ct);

        await client.Usage.GetAsync(new UsageClient.GetOptions { Days = 7 }, ct);
        await client.Usage.GetCreditsAsync(ct);

        var spec = await client.General.GetOpenApiSpecAsync(ct);
        Require(spec.Count > 0, "OpenAPI spec dictionary");
    }

    /// <summary>
    /// Executes all 10 X API v2 workflow suites (covering all 24 endpoint groups) and returns per-suite timings in ms.
    /// </summary>
    public static async Task<IReadOnlyDictionary<string, long>> RunAllAsync(
        string baseUrl,
        XClient client,
        CancellationToken ct = default)
    {
        var suites = new (string Name, Func<Task> Run)[]
        {
            ("01_authentication_flows", () => RunAuthenticationExamplesAsync(baseUrl, ct)),
            ("02_posts_and_search", () => RunPostsAndSearchExamplesAsync(client, ct)),
            ("03_users_social_and_bookmarks", () => RunUsersAndBookmarksExamplesAsync(client, ct)),
            ("04_realtime_streaming", () => RunStreamingExamplesAsync(client, ct)),
            ("05_media_upload_and_metadata", () => RunMediaUploadExamplesAsync(client, ct)),
            ("06_direct_messages_and_xchat", () => RunDirectMessagesAndChatExamplesAsync(client, ct)),
            ("07_lists_communities_spaces_calls", () => RunCommunitiesSpacesListsExamplesAsync(client, ct)),
            ("08_trends_news_articles_notes", () => RunDiscoveryAndNotesExamplesAsync(client, ct)),
            ("09_webhooks_activity_bots_account", () => RunWebhooksAndAutomationExamplesAsync(client, ct)),
            ("10_compliance_usage_and_openapi", () => RunComplianceAndUsageExamplesAsync(client, ct)),
        };

        var timings = new Dictionary<string, long>();
        foreach (var (name, run) in suites)
        {
            var sw = Stopwatch.StartNew();
            await run().ConfigureAwait(false);
            sw.Stop();
            timings[name] = sw.ElapsedMilliseconds;
        }
        return timings;
    }

    private static void Require(bool condition, string message)
    {
        if (!condition)
        {
            throw new InvalidOperationException($"Example assertion failed: {message}");
        }
    }
}
