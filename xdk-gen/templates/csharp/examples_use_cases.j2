    /// <summary>
    /// 1. Authentication Flows: Bearer Token, OAuth 2.0 PKCE + Refresh, and OAuth 1.0a User Context.
    /// </summary>
    public static async Task RunAuthenticationExamplesAsync(string baseUrl, CancellationToken ct = default)
    {
        // 1a. App-Only Bearer Token
        using var bearerClient = new XClient(new XClientOptions
        {
            BaseUrl = baseUrl,
            BearerToken = "app_only_bearer_token",
        });
        var appLookup = await bearerClient.Users.GetByUsernameAsync("XDevelopers", cancellationToken: ct);
        Require(appLookup.Data != null, "Bearer lookup should return data");

        // 1b. OAuth 2.0 Authorization Code with PKCE + Token Refresh
        var oauth2 = new OAuth2Pkce(
            clientId: "demo_client_id",
            redirectUri: "https://example.org/oauth/callback",
            clientSecret: "demo_client_secret",
            scopes: new[] { "tweet.read", "tweet.write", "users.read", "offline.access" },
            apiBaseUrl: baseUrl);
        using var oauth2Client = new XClient(new XClientOptions
        {
            BaseUrl = baseUrl,
            OAuth2 = oauth2,
        });
        var authUrl = oauth2.GetAuthorizationUrl("state_token_abc");
        Require(authUrl.Contains("code_challenge_method=S256", StringComparison.Ordinal), "PKCE S256 URL expected");
        var token = await oauth2.ExchangeCodeAsync("sample_auth_code", cancellationToken: ct);
        Require(!string.IsNullOrEmpty(token.AccessToken), "Exchanged access token expected");
        var me = await oauth2Client.Users.GetMeAsync(cancellationToken: ct);
        Require(me.Data != null, "OAuth2 GetMeAsync should succeed");
        await oauth2Client.RefreshTokenAsync(ct);

        // 1c. OAuth 1.0a User Context (HMAC-SHA1)
        var oauth1 = new OAuth1("consumer_key", "consumer_secret", "oob", "user_access_token", "user_access_secret");
        using var oauth1Client = new XClient(new XClientOptions
        {
            BaseUrl = baseUrl,
            OAuth1 = oauth1,
        });
        var created = await oauth1Client.Posts.CreateAsync(
            new CreatePostsRequest { Text = "Posting with OAuth 1.0a from C#!" },
            ct);
        Require(created != null, "OAuth1 post creation should succeed");
    }

    /// <summary>
    /// 2. Posts, Search, Post Counts &amp; Analytics (<see cref="PostsClient"/>).
    /// </summary>
    public static async Task RunPostsAndSearchExamplesAsync(XClient client, CancellationToken ct = default)
    {
        var created = await client.Posts.CreateAsync(new CreatePostsRequest
        {
            Text = "Shipping Java & C# SDKs on X API v2!",
            ReplySettings = "everyone",
        }, ct);
        Require(created != null, "CreateAsync");

        var lookupOpts = new PostsClient.GetByIdOptions
        {
            PostFields = new List<string> { "created_at", "public_metrics", "author_id" },
            Expansions = new List<string> { "author_id" },
            UserFields = new List<string> { "username", "verified" },
        };
        var post = await client.Posts.GetByIdAsync("1234567890", lookupOpts, ct);
        Require(post != null, "GetByIdAsync");
        await client.Posts.GetByIdsAsync(new List<string> { "1234567890", "1234567891" }, cancellationToken: ct);

        var pageCount = 0;
        await foreach (var page in client.Posts.SearchRecentPages(
            "from:XDevelopers -is:retweet",
            new PostsClient.SearchRecentOptions { MaxResults = 10 }).WithCancellation(ct))
        {
            Require(page != null, "SearchRecentPages");
            if (++pageCount >= 2) break;
        }
        await client.Posts.SearchAllAsync("xdk sdk", new PostsClient.SearchAllOptions { MaxResults = 10 }, ct);

        await client.Posts.GetCountsRecentAsync("xdk", new PostsClient.GetCountsRecentOptions { Granularity = "day" }, ct);
        await client.Posts.GetCountsAllAsync("xdk", cancellationToken: ct);
        await client.Posts.GetAnalyticsAsync(
            new List<string> { "1234567890" },
            "2025-01-01T00:00:00Z",
            "2025-01-07T00:00:00Z",
            cancellationToken: ct);
        await client.Posts.GetLikingUsersAsync("1234567890", cancellationToken: ct);
        await client.Posts.GetRepostedByAsync("1234567890", cancellationToken: ct);
        await client.Posts.GetQuotedAsync("1234567890", cancellationToken: ct);
        await client.Posts.HideReplyAsync("1234567890", new HidePostsReplyRequest { Hidden = true }, ct);
        await client.Posts.DeleteAsync("1234567890", ct);
    }

    /// <summary>
