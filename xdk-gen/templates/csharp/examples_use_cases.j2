    /// <summary>
    /// 4. Real-Time Filtered &amp; Sample Streaming (<see cref="StreamClient"/>).
    /// </summary>
    public static async Task RunStreamingExamplesAsync(XClient client, CancellationToken ct = default)
    {
        await client.Stream.UpdateRulesAsync(new UpdateRulesRequest
        {
            Add = new List<UpdateRulesAdd>
            {
                new() { Value = "xdk (java OR csharp) -is:retweet", Tag = "xdk-mentions" },
            },
        }, cancellationToken: ct);
        await client.Stream.GetRulesAsync(cancellationToken: ct);
        await client.Stream.GetRuleCountsAsync(cancellationToken: ct);

        var streamOpts = new StreamOptions
        {
            MaxRetries = 2,
            InitialBackoff = TimeSpan.FromMilliseconds(25),
            MaxBackoff = TimeSpan.FromMilliseconds(100),
        };

        var received = 0;
        await using (var stream = client.Stream.PostsStream(new StreamClient.PostsOptions
        {
            TweetFields = new List<string> { "created_at", "author_id" },
            StreamOptions = streamOpts,
        }))
        {
            await foreach (var item in stream.WithCancellation(ct))
            {
                Require(item != null, "Filtered stream item");
                if (++received >= 2) break;
            }
        }
        Require(received > 0, "Filtered stream should emit events");

        await using (var sample = client.Stream.PostsSampleStream(new StreamClient.PostsSampleOptions
        {
            StreamOptions = streamOpts,
        }))
        {
            var gotSample = false;
            await foreach (var item in sample.WithCancellation(ct))
            {
                gotSample = item != null;
                break;
            }
            Require(gotSample, "Sample stream should emit event");
        }
    }

    /// <summary>
    /// 5. Media Upload, Chunked Large Video &amp; Metadata (<see cref="MediaClient"/>).
    /// </summary>
    public static async Task RunMediaUploadExamplesAsync(XClient client, CancellationToken ct = default)
    {
        var base64Chunk = Convert.ToBase64String(Encoding.UTF8.GetBytes("fake_mp4_segment_bytes"));

        await client.Media.UploadAsync(new MediaUploadRequest
        {
            Media = base64Chunk,
            MediaCategory = "tweet_image",
        }, ct);

        // Chunked >2 GiB video upload lifecycle (64-bit TotalBytes!)
        var init = await client.Media.InitializeUploadAsync(new InitializeMediaUploadRequest
        {
            TotalBytes = 3_221_225_472L, // 3 GiB
            MediaType = "video/mp4",
            MediaCategory = "tweet_video",
        }, ct);
        var mediaId = init.Data?.Id ?? "1889990001";

        await client.Media.AppendUploadAsync(mediaId, new AppendMediaUploadRequest
        {
            SegmentIndex = 0,
            Media = base64Chunk,
        }, ct);
        await client.Media.FinalizeUploadAsync(mediaId, ct);
        await client.Media.GetUploadStatusAsync(mediaId, new MediaClient.GetUploadStatusOptions { Command = "STATUS" }, ct);

        await client.Media.CreateMetadataAsync(new CreateMediaMetadataRequest { Id = mediaId }, ct);
        await client.Media.CreateSubtitlesAsync(new CreateMediaSubtitlesRequest
        {
            Id = mediaId,
            MediaCategory = "tweet_video",
        }, ct);
        await client.Media.GetByKeysAsync(new List<string> { "3_" + mediaId }, cancellationToken: ct);
        await client.Media.GetAnalyticsAsync(
            new List<string> { "3_" + mediaId },
            "2025-01-01T00:00:00Z",
            "2025-01-07T00:00:00Z",
            cancellationToken: ct);
        await client.Media.GetLibraryCategoriesAsync(cancellationToken: ct);
    }

    /// <summary>
    /// 6. Direct Messages &amp; Encrypted XChat (<see cref="DirectMessagesClient"/>, <see cref="ChatClient"/>).
    /// </summary>
    public static async Task RunDirectMessagesAndChatExamplesAsync(XClient client, CancellationToken ct = default)
    {
        await client.DirectMessages.CreateByParticipantIdAsync(
            "783214",
            new CreateDirectMessagesByParticipantIdRequest { Text = "Hey from XDK C#!" },
            ct);
        await client.DirectMessages.CreateConversationAsync(new CreateDirectMessagesConversationRequest
        {
            ConversationType = "Group",
            ParticipantIds = new List<string> { "783214", "2244994945" },
        }, ct);
        await client.DirectMessages.CreateByConversationIdAsync(
            "conv_1",
            new CreateDirectMessagesByConversationIdRequest { Text = "Welcome to the group DM!" },
            ct);
        await foreach (var dmPage in client.DirectMessages.GetEventsPages(
            new DirectMessagesClient.GetEventsOptions { MaxResults = 10 }).WithCancellation(ct))
        {
            Require(dmPage != null, "DM events page");
            break;
        }
        var dmMedia = await client.DirectMessages.DmConversationsMediaDownloadAsync("dm_1", "m_1", "r_1", ct);
        Require(dmMedia.Length > 0, "DM media binary download");
        await client.DirectMessages.DeleteEventsAsync("ev_1", ct);

        // Encrypted XChat & public keys
        await client.Users.GetPublicKeysAsync(new List<string> { "2244994945" }, cancellationToken: ct);
        await client.Chat.GetSettingsAsync(cancellationToken: ct);
        await client.Chat.SendMessageAsync("chat_conv_1", new SendChatMessageRequest
        {
            EncodedMessageCreateEvent = "base64_encrypted_event",
            MessageId = "msg_001",
        }, ct);
        await client.Chat.GetConversationEventsAsync("chat_conv_1", cancellationToken: ct);
        await client.Chat.MediaUploadInitializeAsync(new ChatMediaUploadInitializeRequest
        {
            ConversationId = "chat_conv_1",
            TotalBytes = 1_048_576L,
        }, ct);
        await client.Chat.MediaUploadAppendAsync("upload_1", new ChatMediaUploadAppendRequest
        {
            ConversationId = "chat_conv_1",
            MediaHashKey = "hash_1",
            SegmentIndex = 0,
            Media = "Y2hhdF9tZWRpYQ==",
        }, ct);
        var chatBytes = await client.Chat.MediaDownloadAsync("chat_conv_1", "hash_1", ct);
        Require(chatBytes.Length > 0, "XChat media download");
    }

