        await client.Users.GetByUsernamesAsync(new List<string> { "XDevelopers", "X" }, cancellationToken: ct);
        await client.Users.GetByIdAsync(myId, cancellationToken: ct);
        await client.Users.GetByIdsAsync(new List<string> { myId, "783214" }, cancellationToken: ct);
        await client.Users.SearchAsync("developer platform", cancellationToken: ct);

        var timelinePages = 0;
        await foreach (var page in client.Users.GetPostsPages(
            myId,
            new UsersClient.GetPostsOptions { MaxResults = 10 }).WithCancellation(ct))
        {
            Require(page != null, "GetPostsPages");
            if (++timelinePages >= 2) break;
        }
        await client.Users.GetMentionsAsync(myId, cancellationToken: ct);
        await client.Users.GetTimelineAsync(myId, cancellationToken: ct);

        await client.Users.FollowUserAsync(myId, new FollowUserRequest { TargetUserId = "783214" }, ct);
        await foreach (var fPage in client.Users.GetFollowersPages(myId).WithCancellation(ct))
        {
            Require(fPage != null, "GetFollowersPages");
            break;
        }
        await client.Users.GetFollowingAsync(myId, cancellationToken: ct);
        await client.Users.LikePostAsync(myId, new LikePostRequest { TweetId = "1234567890" }, ct);
        await client.Users.UnlikePostAsync(myId, "1234567890", ct);
        await client.Users.RepostPostAsync(myId, new RepostPostRequest { TweetId = "1234567890" }, ct);
        await client.Users.UnrepostPostAsync(myId, "1234567890", ct);
        await client.Users.IdBlockAsync(myId, new UsersIdBlockRequest { TargetUserId = "99999" }, ct);
        await client.Users.IdUnblockAsync(myId, "99999", ct);
        await client.Users.MuteUserAsync(myId, new MuteUserRequest { TargetUserId = "99999" }, ct);
        await client.Users.UnmuteUserAsync(myId, "99999", ct);
        await client.Users.UnfollowUserAsync(myId, "783214", ct);

        await client.Users.CreateBookmarkAsync(myId, new CreateUsersBookmarkRequest { TweetId = "1234567890" }, ct);
        await foreach (var bmPage in client.Users.GetBookmarksPages(myId).WithCancellation(ct))
        {
            Require(bmPage != null, "GetBookmarksPages");
            break;
        }
        await client.Users.CreateBookmarkFolderAsync(myId, new CreateUsersBookmarkFolderRequest { Name = "SDK Docs" }, ct);
        await client.Users.GetBookmarkFoldersAsync(myId, cancellationToken: ct);
        await client.Users.DeleteBookmarkAsync(myId, "1234567890", ct);
