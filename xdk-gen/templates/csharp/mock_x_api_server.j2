using System;
using System.Collections.Concurrent;
using System.Collections.Generic;
using System.Globalization;
using System.IO;
using System.Linq;
using System.Net;
using System.Net.Sockets;
using System.Security.Cryptography;
using System.Text;
using System.Threading;
using System.Threading.Tasks;

namespace Xdk.Testing;

/// <summary>
/// Local TCP loopback X API v2 simulator and programmable HTTP/1.1 test server built on <see cref="TcpListener"/>.
/// Zero external dependencies; exercises real <see cref="System.Net.Http.HttpClient"/> TCP sockets.
/// </summary>
public sealed class MockXApiServer : IDisposable, IAsyncDisposable
{
    public sealed class RecordedRequest
    {
        public string Method { get; }
        public string Path { get; }
        public string RawQuery { get; }
        public string FullUrl { get; }
        public IReadOnlyDictionary<string, string> Headers { get; }
        public byte[] BodyBytes { get; }
        public string BodyUtf8 => Encoding.UTF8.GetString(BodyBytes);

        public RecordedRequest(
            string method,
            string path,
            string rawQuery,
            string fullUrl,
            IDictionary<string, string> headers,
            byte[] bodyBytes)
        {
            Method = method;
            Path = path;
            RawQuery = rawQuery;
            FullUrl = fullUrl;
            Headers = new Dictionary<string, string>(headers, StringComparer.OrdinalIgnoreCase);
            BodyBytes = bodyBytes;
        }

        public string? FirstHeader(string name) =>
            Headers.TryGetValue(name, out var val) ? val : null;
    }

    public sealed class MockResponse
    {
        public int StatusCode { get; }
        public IReadOnlyDictionary<string, string> Headers { get; }
        public byte[]? Body { get; }
        public IReadOnlyList<byte[]>? StreamChunks { get; }
        public bool DropStreamMidway { get; }
        public int DelayMs { get; }

        private MockResponse(
            int statusCode,
            IDictionary<string, string>? headers,
            byte[]? body,
            IReadOnlyList<byte[]>? streamChunks,
            bool dropStreamMidway,
            int delayMs)
        {
            StatusCode = statusCode;
            var h = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            if (headers != null)
            {
                foreach (var kv in headers)
                {
                    h[kv.Key] = kv.Value;
                }
            }
            Headers = h;
            Body = body;
            StreamChunks = streamChunks;
            DropStreamMidway = dropStreamMidway;
            DelayMs = delayMs;
        }

        public static MockResponse Json(int statusCode, string json, IDictionary<string, string>? extraHeaders = null)
        {
            var h = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
                ["Content-Type"] = "application/json",
            };
            if (extraHeaders != null)
            {
                foreach (var kv in extraHeaders) h[kv.Key] = kv.Value;
            }
            return new MockResponse(statusCode, h, Encoding.UTF8.GetBytes(json), null, false, 0);
        }

        public static MockResponse Bytes(int statusCode, string contentType, byte[] data) =>
            new(
                statusCode,
                new Dictionary<string, string> { ["Content-Type"] = contentType },
                data,
                null,
                false,
                0);

        public static MockResponse DelayedJson(int statusCode, string json, int delayMs) =>
            new(
                statusCode,
                new Dictionary<string, string> { ["Content-Type"] = "application/json" },
                Encoding.UTF8.GetBytes(json),
                null,
                false,
                delayMs);

        public static MockResponse ChunkedStream(IReadOnlyList<byte[]> chunks, bool dropMidway = false) =>
            new(
                200,
                new Dictionary<string, string> { ["Content-Type"] = "application/json" },
                null,
                chunks,
                dropMidway,
                0);
    }

    private readonly TcpListener _listener;
    private readonly CancellationTokenSource _cts = new();
    private readonly Task _acceptLoop;
    private readonly ConcurrentQueue<RecordedRequest> _requests = new();
    private readonly ConcurrentDictionary<string, string> _expectedPkceChallenges = new();
    private volatile Func<RecordedRequest, MockResponse?>? _customResponder;

    public int Port { get; }
    public string BaseUrl { get; }

    public MockXApiServer()
    {
        _listener = new TcpListener(IPAddress.Loopback, 0);
        _listener.Start();
        Port = ((IPEndPoint)_listener.LocalEndpoint).Port;
        BaseUrl = $"http://127.0.0.1:{Port}";
        _acceptLoop = Task.Run(AcceptLoopAsync);
    }

    public IReadOnlyList<RecordedRequest> Requests => _requests.ToArray();

    public RecordedRequest? LastRequest => _requests.LastOrDefault();

    public void Reset()
    {
        while (_requests.TryDequeue(out _)) { }
        _customResponder = null;
        _expectedPkceChallenges.Clear();
    }

    public void SetResponder(Func<RecordedRequest, MockResponse?>? responder) =>
        _customResponder = responder;

    public void RegisterExpectedPkceChallenge(string authCode, string codeChallenge) =>
        _expectedPkceChallenges[authCode] = codeChallenge;

    public void Dispose()
    {
        _cts.Cancel();
        try { _listener.Stop(); } catch { }
    }

    public ValueTask DisposeAsync()
    {
        Dispose();
        return ValueTask.CompletedTask;
    }

    private async Task AcceptLoopAsync()
    {
        while (!_cts.IsCancellationRequested)
        {
            TcpClient client;
            try
            {
                client = await _listener.AcceptTcpClientAsync(_cts.Token).ConfigureAwait(false);
            }
            catch
            {
                break;
            }
            _ = Task.Run(() => HandleClientAsync(client));
        }
    }

    private async Task HandleClientAsync(TcpClient client)
    {
        using (client)
        await using (var stream = client.GetStream())
        {
            while (!_cts.IsCancellationRequested)
            {
                RecordedRequest? recorded;
                try
                {
                    recorded = await ReadHttpRequestAsync(stream, _cts.Token).ConfigureAwait(false);
                    if (recorded == null)
                    {
                        break;
                    }
                }
                catch
                {
                    break;
                }

                _requests.Enqueue(recorded);

                var responder = _customResponder;
                var response = responder?.Invoke(recorded) ?? DefaultSimulatorResponse(recorded);

                if (response.DelayMs > 0)
                {
                    try
                    {
                        await Task.Delay(response.DelayMs, _cts.Token).ConfigureAwait(false);
                    }
                    catch
                    {
                        break;
                    }
                }

                try
                {
                    var closeAfter = await WriteHttpResponseAsync(stream, recorded, response, _cts.Token)
                        .ConfigureAwait(false);
                    if (closeAfter)
                    {
                        break;
                    }
                }
                catch
                {
                    break;
                }
            }
        }
    }

    private async Task<RecordedRequest?> ReadHttpRequestAsync(NetworkStream stream, CancellationToken ct)
    {
        var headerBuf = new List<byte>(1024);
        var one = new byte[1];
        while (true)
        {
            var n = await stream.ReadAsync(one.AsMemory(0, 1), ct).ConfigureAwait(false);
            if (n == 0)
            {
                return null;
            }
            headerBuf.Add(one[0]);
            var c = headerBuf.Count;
            if (c >= 4
                && headerBuf[c - 4] == '\r'
                && headerBuf[c - 3] == '\n'
                && headerBuf[c - 2] == '\r'
                && headerBuf[c - 1] == '\n')
            {
                break;
            }
        }

        var headerText = Encoding.ASCII.GetString(headerBuf.ToArray());
        var lines = headerText.Split("\r\n", StringSplitOptions.RemoveEmptyEntries);
        if (lines.Length == 0)
        {
            return null;
        }

        var reqLine = lines[0].Split(' ', 3);
        var method = reqLine[0];
        var rawTarget = reqLine.Length > 1 ? reqLine[1] : "/";
        var qIdx = rawTarget.IndexOf('?');
        var rawPath = qIdx >= 0 ? rawTarget[..qIdx] : rawTarget;
        var rawQuery = qIdx >= 0 ? rawTarget[(qIdx + 1)..] : string.Empty;

        var headers = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        for (var i = 1; i < lines.Length; i++)
        {
            var colon = lines[i].IndexOf(':');
            if (colon > 0)
            {
                var k = lines[i][..colon].Trim();
                var v = lines[i][(colon + 1)..].Trim();
                headers[k] = v;
            }
        }

        var bodyBytes = Array.Empty<byte>();
        if (headers.TryGetValue("Transfer-Encoding", out var te)
            && te.Contains("chunked", StringComparison.OrdinalIgnoreCase))
        {
            using var ms = new MemoryStream();
            while (true)
            {
                var sizeLine = await ReadAsciiLineAsync(stream, ct).ConfigureAwait(false);
                var semi = sizeLine.IndexOf(';');
                var hex = (semi >= 0 ? sizeLine[..semi] : sizeLine).Trim();
                var chunkSize = int.Parse(hex, NumberStyles.HexNumber, CultureInfo.InvariantCulture);
                if (chunkSize == 0)
                {
                    await ReadAsciiLineAsync(stream, ct).ConfigureAwait(false);
                    break;
                }
                var chunk = await ReadExactBytesAsync(stream, chunkSize, ct).ConfigureAwait(false);
                ms.Write(chunk, 0, chunk.Length);
                await ReadAsciiLineAsync(stream, ct).ConfigureAwait(false);
            }
            bodyBytes = ms.ToArray();
        }
        else if (headers.TryGetValue("Content-Length", out var clStr)
            && int.TryParse(clStr, NumberStyles.Integer, CultureInfo.InvariantCulture, out var contentLength)
            && contentLength > 0)
        {
            bodyBytes = await ReadExactBytesAsync(stream, contentLength, ct).ConfigureAwait(false);
        }

        var fullUrl = BaseUrl + rawPath + (string.IsNullOrEmpty(rawQuery) ? "" : "?" + rawQuery);
        return new RecordedRequest(method, rawPath, rawQuery, fullUrl, headers, bodyBytes);
    }

    private static async Task<string> ReadAsciiLineAsync(NetworkStream stream, CancellationToken ct)
    {
        var bytes = new List<byte>(64);
        var b = new byte[1];
        while (true)
        {
            var n = await stream.ReadAsync(b.AsMemory(0, 1), ct).ConfigureAwait(false);
            if (n == 0) break;
            bytes.Add(b[0]);
            var c = bytes.Count;
            if (c >= 2 && bytes[c - 2] == '\r' && bytes[c - 1] == '\n')
            {
                bytes.RemoveRange(c - 2, 2);
                break;
            }
        }
        return Encoding.ASCII.GetString(bytes.ToArray());
    }

    private static async Task<byte[]> ReadExactBytesAsync(NetworkStream stream, int count, CancellationToken ct)
    {
        var buf = new byte[count];
        var read = 0;
        while (read < count)
        {
            var n = await stream.ReadAsync(buf.AsMemory(read, count - read), ct).ConfigureAwait(false);
            if (n == 0) break;
            read += n;
        }
        return buf;
    }

    private static async Task<bool> WriteHttpResponseAsync(
        NetworkStream stream,
        RecordedRequest req,
        MockResponse res,
        CancellationToken ct)
    {
        var reason = res.StatusCode switch
        {
            200 => "OK",
            201 => "Created",
            204 => "No Content",
            400 => "Bad Request",
            401 => "Unauthorized",
            403 => "Forbidden",
            404 => "Not Found",
            429 => "Too Many Requests",
            503 => "Service Unavailable",
            _ => "Status",
        };

        var clientWantsClose = req.FirstHeader("Connection")?.Equals("close", StringComparison.OrdinalIgnoreCase) == true;
        var sb = new StringBuilder();
        sb.Append($"HTTP/1.1 {res.StatusCode} {reason}\r\n");
        foreach (var kv in res.Headers)
        {
            sb.Append($"{kv.Key}: {kv.Value}\r\n");
        }

        if (res.StreamChunks != null)
        {
            sb.Append("Transfer-Encoding: chunked\r\n");
            sb.Append("Connection: close\r\n\r\n");
            var headBytes = Encoding.ASCII.GetBytes(sb.ToString());
            await stream.WriteAsync(headBytes, ct).ConfigureAwait(false);

            foreach (var chunk in res.StreamChunks)
            {
                if (chunk.Length == 0) continue;
                var prefix = Encoding.ASCII.GetBytes($"{chunk.Length:X}\r\n");
                await stream.WriteAsync(prefix, ct).ConfigureAwait(false);
                await stream.WriteAsync(chunk, ct).ConfigureAwait(false);
                await stream.WriteAsync("\r\n"u8.ToArray(), ct).ConfigureAwait(false);
                await stream.FlushAsync(ct).ConfigureAwait(false);
            }

            if (res.DropStreamMidway)
            {
                // Intentionally close TCP socket before sending terminating 0\r\n\r\n chunk!
                return true;
            }

            await stream.WriteAsync("0\r\n\r\n"u8.ToArray(), ct).ConfigureAwait(false);
            await stream.FlushAsync(ct).ConfigureAwait(false);
            return true;
        }
        else
        {
            var body = res.Body ?? Array.Empty<byte>();
            sb.Append($"Content-Length: {body.Length}\r\n");
            sb.Append("Connection: close\r\n\r\n");
            var headBytes = Encoding.ASCII.GetBytes(sb.ToString());
            await stream.WriteAsync(headBytes, ct).ConfigureAwait(false);
            if (body.Length > 0)
            {
                await stream.WriteAsync(body, ct).ConfigureAwait(false);
            }
            await stream.FlushAsync(ct).ConfigureAwait(false);
            return true;
        }
    }

    private MockResponse DefaultSimulatorResponse(RecordedRequest req)
    {
        var path = req.Path;
        var method = req.Method;

        if (path == "/2/oauth2/token" && method.Equals("POST", StringComparison.OrdinalIgnoreCase))
        {
            var form = ParseFormUrlEncoded(req.BodyUtf8);
            var grantType = form.GetValueOrDefault("grant_type");
            if (grantType == "authorization_code")
            {
                var code = form.GetValueOrDefault("code", "");
                var verifier = form.GetValueOrDefault("code_verifier", "");
                if (_expectedPkceChallenges.TryGetValue(code, out var expectedChallenge))
                {
                    var computed = ComputeS256Challenge(verifier);
                    if (!string.Equals(expectedChallenge, computed, StringComparison.Ordinal))
                    {
                        return MockResponse.Json(400, "{\"error\":\"invalid_grant\",\"detail\":\"PKCE S256 mismatch\"}");
                    }
                }
                return MockResponse.Json(
                    200,
                    "{\"access_token\":\"sim_oauth2_access_" + code + "\",\"token_type\":\"bearer\",\"expires_in\":7200,"
                    + "\"refresh_token\":\"sim_oauth2_refresh_1\",\"scope\":\"tweet.read users.read offline.access\"}");
            }
            if (grantType == "refresh_token")
            {
                var rt = form.GetValueOrDefault("refresh_token", "unknown");
                return MockResponse.Json(
                    200,
                    "{\"access_token\":\"sim_refreshed_access_from_" + rt + "\",\"token_type\":\"bearer\",\"expires_in\":7200,"
                    + "\"refresh_token\":\"sim_oauth2_refresh_2\",\"scope\":\"tweet.read users.read offline.access\"}");
            }
            return MockResponse.Json(400, "{\"error\":\"unsupported_grant_type\"}");
        }

        if (path == "/2/openapi.json")
        {
            return MockResponse.Json(200, "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"X API v2\",\"version\":\"2.175\"}}");
        }

        if (path.EndsWith("/download", StringComparison.Ordinal)
            || (path.StartsWith("/2/chat/media/", StringComparison.Ordinal) && method.Equals("GET", StringComparison.OrdinalIgnoreCase))
            || (path.StartsWith("/2/dm_conversations/media/", StringComparison.Ordinal) && method.Equals("GET", StringComparison.OrdinalIgnoreCase)))
        {
            return MockResponse.Bytes(
                200,
                "application/octet-stream",
                Encoding.UTF8.GetBytes("{\"id\":\"1234567890\",\"status\":\"compliant\"}\n"));
        }

        if ((path.Contains("/stream", StringComparison.Ordinal)
                && !path.EndsWith("/rules", StringComparison.Ordinal)
                && !path.Contains("/rules/", StringComparison.Ordinal))
            || path.Contains("/sample", StringComparison.Ordinal)
            || path.Contains("/firehose", StringComparison.Ordinal))
        {
            return MockResponse.ChunkedStream(new[]
            {
                Encoding.UTF8.GetBytes("{}\r\n"),
                Encoding.UTF8.GetBytes("{\"data\":{\"id\":\"1880000001\",\"text\":\"Live stream event 1 🚀\",\"timestamp_ms\":1735000000000}}\n"),
                Encoding.UTF8.GetBytes("{\"data\":{\"id\":\"1880000002\",\"text\":\"Live stream event 2\",\"timestamp_ms\":1735000001000}}\n"),
            });
        }

        if (path.StartsWith("/2/media/upload", StringComparison.Ordinal))
        {
            if (path.EndsWith("/append", StringComparison.Ordinal))
            {
                return MockResponse.Json(200, "{\"data\":{\"expires_after_secs\":86400}}");
            }
            return MockResponse.Json(
                200,
                "{\"data\":{\"id\":\"1889990001\",\"media_key\":\"3_1889990001\",\"size\":5242880,\"expires_after_secs\":86400,\"processing_info\":{\"state\":\"succeeded\",\"progress_percent\":100}}}");
        }

        var query = req.RawQuery;
        var hasCursor = query.Contains("pagination_token=", StringComparison.Ordinal)
            || query.Contains("next_token=", StringComparison.Ordinal);
        var looksLikeCollection =
            (method.Equals("POST", StringComparison.OrdinalIgnoreCase) && path == "/2/tweets/search/stream/rules")
            || (method.Equals("GET", StringComparison.OrdinalIgnoreCase)
                && path != "/2/tweets/search/stream/rules/counts"
                && (path.Contains("/search/", StringComparison.Ordinal)
                    || path.EndsWith("/search", StringComparison.Ordinal)
                    || path.EndsWith("/followers", StringComparison.Ordinal)
                    || path.EndsWith("/following", StringComparison.Ordinal)
                    || path.EndsWith("/bookmarks", StringComparison.Ordinal)
                    || path.EndsWith("/bookmarks/folders", StringComparison.Ordinal)
                    || path.EndsWith("/reverse_chronological", StringComparison.Ordinal)
                    || (path.EndsWith("/tweets", StringComparison.Ordinal) && !path.StartsWith("/2/usage/", StringComparison.Ordinal))
                    || path.EndsWith("/personalized_trends", StringComparison.Ordinal)
                    || path.EndsWith("/mentions", StringComparison.Ordinal)
                    || path.EndsWith("/liking_users", StringComparison.Ordinal)
                    || path.EndsWith("/retweeted_by", StringComparison.Ordinal)
                    || path.EndsWith("/quote_tweets", StringComparison.Ordinal)
                    || path.EndsWith("/members", StringComparison.Ordinal)
                    || path.EndsWith("/lists", StringComparison.Ordinal)
                    || path.EndsWith("/rules", StringComparison.Ordinal)
                    || path.EndsWith("/jobs", StringComparison.Ordinal)
                    || path.EndsWith("/webhooks", StringComparison.Ordinal)
                    || (path.EndsWith("/subscriptions", StringComparison.Ordinal) && !path.Contains("/account_activity/", StringComparison.Ordinal))
                    || path.EndsWith("/dm_events", StringComparison.Ordinal)
                    || path.EndsWith("/events", StringComparison.Ordinal)
                    || path.EndsWith("/analytics", StringComparison.Ordinal)
                    || path.EndsWith("/public_keys", StringComparison.Ordinal)
                    || path.EndsWith("/creator_ids", StringComparison.Ordinal)
                    || path == "/2/broadcasts"
                    || path == "/2/sources"
                    || path == "/2/calls/scheduled"
                    || path == "/2/bots"
                    || path == "/2/connections"
                    || path.Contains("/counts/", StringComparison.Ordinal)
                    || path.Contains("/trends/", StringComparison.Ordinal)
                    || query.StartsWith("ids=", StringComparison.Ordinal)
                    || query.Contains("&ids=", StringComparison.Ordinal)
                    || query.StartsWith("usernames=", StringComparison.Ordinal)
                    || query.Contains("&usernames=", StringComparison.Ordinal)
                    || query.StartsWith("user_ids=", StringComparison.Ordinal)
                    || query.Contains("&user_ids=", StringComparison.Ordinal)
                    || query.StartsWith("media_keys=", StringComparison.Ordinal)
                    || query.Contains("&media_keys=", StringComparison.Ordinal)));

        var status = method.Equals("POST", StringComparison.OrdinalIgnoreCase)
            && (path == "/2/tweets" || path == "/2/lists")
            ? 201
            : 200;

        if (looksLikeCollection)
        {
            if (!hasCursor
                && (query.Contains("max_results=", StringComparison.Ordinal)
                    || path.EndsWith("/followers", StringComparison.Ordinal)
                    || path.Contains("/search/", StringComparison.Ordinal)))
            {
                return MockResponse.Json(
                    status,
                    "{\"data\":[{\"id\":\"1001\",\"name\":\"Item 1\",\"username\":\"XDevelopers\",\"text\":\"First item\"},"
                    + "{\"id\":\"1002\",\"name\":\"Item 2\",\"username\":\"XApi\",\"text\":\"Second item\"}],"
                    + "\"meta\":{\"result_count\":2,\"next_token\":\"sim_page_2\"}}");
            }
            return MockResponse.Json(
                status,
                "{\"data\":[{\"id\":\"1003\",\"name\":\"Item 3\",\"username\":\"XEng\",\"text\":\"Final page item\"}],"
                + "\"meta\":{\"result_count\":1}}");
        }

        if (method.Equals("DELETE", StringComparison.OrdinalIgnoreCase))
        {
            return MockResponse.Json(
                200,
                "{\"data\":{\"deleted\":true,\"following\":false,\"liked\":false,\"bookmarked\":false}}");
        }

        return MockResponse.Json(
            status,
            "{\"data\":{\"id\":\"1234567890\",\"name\":\"X Developers\",\"username\":\"XDevelopers\","
            + "\"text\":\"Hello from XDK!\",\"created_at\":\"2025-01-15T12:00:00.000Z\","
            + "\"bookmarked\":true,\"liked\":true,\"following\":true,\"valid\":true,"
            + "\"subscribed\":true,\"project_usage\":\"1024\",\"project_cap\":\"1000000\"}}");
    }

    public static bool VerifyOAuth1Signature(
        RecordedRequest req,
        string consumerSecret,
        string tokenSecret)
    {
        var auth = req.FirstHeader("Authorization");
        if (string.IsNullOrEmpty(auth) || !auth.StartsWith("OAuth ", StringComparison.Ordinal))
        {
            return false;
        }

        var oauthParams = new Dictionary<string, string>(StringComparer.Ordinal);
        foreach (var part in auth["OAuth ".Length..].Split(','))
        {
            var trimmed = part.Trim();
            var eq = trimmed.IndexOf('=');
            if (eq > 0)
            {
                var k = Uri.UnescapeDataString(trimmed[..eq].Trim());
                var v = trimmed[(eq + 1)..].Trim();
                if (v.Length >= 2 && v.StartsWith('"') && v.EndsWith('"'))
                {
                    v = v[1..^1];
                }
                oauthParams[k] = Uri.UnescapeDataString(v);
            }
        }

        if (!oauthParams.Remove("oauth_signature", out var receivedSig))
        {
            return false;
        }

        var pairs = new List<(string Key, string Value)>();
        foreach (var kv in oauthParams)
        {
            pairs.Add((PercentEncode(kv.Key), PercentEncode(kv.Value)));
        }

        if (!string.IsNullOrEmpty(req.RawQuery))
        {
            foreach (var qp in req.RawQuery.Split('&', StringSplitOptions.RemoveEmptyEntries))
            {
                var eq = qp.IndexOf('=');
                var k = eq >= 0 ? Uri.UnescapeDataString(qp[..eq]) : Uri.UnescapeDataString(qp);
                var v = eq >= 0 ? Uri.UnescapeDataString(qp[(eq + 1)..]) : string.Empty;
                pairs.Add((PercentEncode(k), PercentEncode(v)));
            }
        }

        pairs.Sort((a, b) =>
        {
            var kc = string.CompareOrdinal(a.Key, b.Key);
            return kc != 0 ? kc : string.CompareOrdinal(a.Value, b.Value);
        });

        var normalized = string.Join("&", pairs.Select(p => $"{p.Key}={p.Value}"));
        var host = req.FirstHeader("Host") ?? "127.0.0.1";
        var baseUri = $"http://{host}{req.Path}";
        var baseString = $"{req.Method.ToUpperInvariant()}&{PercentEncode(baseUri)}&{PercentEncode(normalized)}";
        var signingKey = $"{PercentEncode(consumerSecret)}&{PercentEncode(tokenSecret)}";

        using var hmac = new HMACSHA1(Encoding.UTF8.GetBytes(signingKey));
        var expectedSig = Convert.ToBase64String(hmac.ComputeHash(Encoding.UTF8.GetBytes(baseString)));
        return CryptographicOperations.FixedTimeEquals(
            Encoding.UTF8.GetBytes(expectedSig),
            Encoding.UTF8.GetBytes(receivedSig));
    }

    private static string ComputeS256Challenge(string verifier)
    {
        var hash = SHA256.HashData(Encoding.ASCII.GetBytes(verifier));
        return Convert.ToBase64String(hash).TrimEnd('=').Replace('+', '-').Replace('/', '_');
    }

    private static Dictionary<string, string> ParseFormUrlEncoded(string body)
    {
        var dict = new Dictionary<string, string>(StringComparer.Ordinal);
        if (string.IsNullOrEmpty(body)) return dict;
        foreach (var pair in body.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = pair.IndexOf('=');
            if (eq >= 0)
            {
                dict[Uri.UnescapeDataString(pair[..eq].Replace('+', ' '))] =
                    Uri.UnescapeDataString(pair[(eq + 1)..].Replace('+', ' '));
            }
        }
        return dict;
    }

    private static string PercentEncode(string value)
    {
        var sb = new StringBuilder();
        foreach (var b in Encoding.UTF8.GetBytes(value))
        {
            if ((b >= 'A' && b <= 'Z')
                || (b >= 'a' && b <= 'z')
                || (b >= '0' && b <= '9')
                || b == '-' || b == '.' || b == '_' || b == '~')
            {
                sb.Append((char)b);
            }
            else
            {
                sb.Append('%').Append(b.ToString("X2", CultureInfo.InvariantCulture));
            }
        }
        return sb.ToString();
    }
}
