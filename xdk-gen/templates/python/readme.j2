## Quick Start

### Bearer Token (App-Only Authentication)

```python
from xdk import Client

client = Client(bearer_token="YOUR_BEARER_TOKEN")

# Look up posts by ID
posts = client.posts.get_by_ids(ids=["1234567890"])
print(posts.data)

# Search recent posts (auto-paginating iterator of pages)
for page in client.posts.search_recent(query="python lang:en", max_results=10):
    print(page.data)
    break
```

### OAuth 2.0 PKCE (User Context + Auto Refresh)

```python
from xdk import Client
from xdk.posts.models import CreateRequest

client = Client(
    client_id="YOUR_CLIENT_ID",
    redirect_uri="http://localhost:3000/callback",
    scope=["tweet.read", "tweet.write", "users.read", "offline.access"],
)

auth_url = client.get_authorization_url(state="csrf-state")
# After user authorizes and redirects back with ?code=...
token = client.exchange_code("AUTH_CODE_FROM_CALLBACK")

created = client.posts.create(body=CreateRequest(text="Hello from XDK Python!"))
print(created.data)
```

### OAuth 1.0a (User Context)

```python
from xdk import Client, OAuth1
from xdk.posts.models import CreateRequest

oauth1 = OAuth1(
    api_key="YOUR_API_KEY",
    api_secret="YOUR_API_SECRET",
    access_token="YOUR_ACCESS_TOKEN",
    access_token_secret="YOUR_ACCESS_TOKEN_SECRET",
)

client = Client(auth=oauth1)
post = client.posts.create(body=CreateRequest(text="Signed with OAuth 1.0a!"))
```

### Pagination (`Cursor`) & Real-Time Streaming (`StreamConfig`)

```python
from xdk import Client, Cursor, StreamConfig

client = Client(bearer_token="YOUR_BEARER_TOKEN")

# Flatten items across pages with Cursor
for post in Cursor(client.posts.search_recent, "xdk", max_results=10).items(limit=25):
    print(post)

# Resilient NDJSON streaming with exponential backoff reconnect
stream_cfg = StreamConfig(max_retries=5, initial_backoff=1.0, timeout=90.0)
for event in client.stream.posts(stream_config=stream_cfg):
    print(event.data)
```

