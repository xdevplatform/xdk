    def test_streaming_incremental_utf8_across_chunk_boundaries(self):
        # 4-byte emoji (U+1F680) + accented French text split right inside multi-byte sequences
        raw_line = '{"data": {"id": "1", "text": "Bonjour 🚀 café"}}\n'.encode("utf-8")
        # Split in the middle of the 4-byte emoji
        emoji_idx = raw_line.index(b"\xf0\x9f\x9a\x80")
        chunks = [raw_line[: emoji_idx + 2], raw_line[emoji_idx + 2 :]]

        mock_resp = mock.Mock(spec=requests.Response)
        mock_resp.iter_content.return_value = iter(chunks)

        items = list(_process_stream(mock_resp, StreamConfig(), StreamState(), None))
        assert len(items) == 1
        assert items[0]["data"]["text"] == "Bonjour 🚀 café"

