    """7. Lists, Communities, Spaces, Broadcasts & Calls."""
    lst = client.lists.create(
        body=schemas.CreateListsRequest(
            name="XDK Contributors",
            description="Core SDK builders",
            private=False,
        )
    )
    _require(lst is not None, "create list")
    client.lists.get_by_id("list_1")
    client.lists.add_member("list_1", body=schemas.AddListsMemberRequest(user_id="783214"))
    _first_if_generator(client.lists.get_members("list_1"))
    _first_if_generator(client.lists.get_posts("list_1", max_results=10))
    client.lists.update("list_1", body=schemas.UpdateListsRequest(description="Updated"))
    client.lists.remove_member_by_user_id("list_1", "783214")
    client.lists.delete("list_1")

    # Communities & Spaces
    _first_if_generator(client.communities.search(query="X Developers"))
    client.communities.get_by_id("comm_1")
    client.spaces.search(query="AI Engineering", state="live")
    client.spaces.get_by_id("1YqKDqWLPPlKV")
    client.spaces.get_by_creator_ids(user_ids=["2244994945"])
    client.spaces.get_posts("1YqKDqWLPPlKV")

    # Broadcasts & Calls
    client.broadcasts.get_region()
    _first_if_generator(client.broadcasts.list())
    _first_if_generator(client.broadcasts.list_sources())
    client.calls.create_call(
        body=schemas.CreateCallRequest(
            conversation_id="chat_conv_1",
            audio_only=True,
            title="SDK Standup",
        )
    )
    client.calls.get_call("call_1")
    _first_if_generator(client.calls.list_scheduled())
