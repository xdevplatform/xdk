"""
Comprehensive, runnable X API v2 Python SDK Cookbook covering every major developer use-case
and all 24 API endpoint groups.

Run standalone against the built-in local X API simulator (or against a custom base URL when
X_API_BASE_URL and X_BEARER_TOKEN / X_ACCESS_TOKEN are set):

    uv run python -m examples.use_cases
"""

from __future__ import annotations

import base64
import itertools
import os
import time
import types
from typing import Any, Callable, Dict, Tuple

from examples.mock_x_api_server import MockXApiServer
from xdk import Client, Cursor, OAuth1, OAuth2PKCEAuth, StreamConfig, schemas


def _require(condition: bool, message: str) -> None:
    if not condition:
        raise AssertionError(message)


def _first_if_generator(value: Any) -> Any:
    """If a paginated SDK method returned a generator, consume the first page so the HTTP call executes."""
    if isinstance(value, types.GeneratorType):
        return next(value, None)
    return value


def run_authentication_examples(base_url: str) -> None:
    """1. Authentication Flows: Bearer Token, OAuth 2.0 PKCE + Refresh, and OAuth 1.0a User Context."""
    # 1a. App-Only Bearer Token
    bearer_client = Client(base_url=base_url, bearer_token="app_only_bearer_token")
    app_lookup = bearer_client.users.get_by_username("XDevelopers")
    _require(app_lookup is not None and app_lookup.data is not None, "Bearer lookup should return data")

    # 1b. OAuth 2.0 Authorization Code with PKCE + Token Refresh
    oauth2 = OAuth2PKCEAuth(
        base_url=base_url,
        authorization_base_url="https://x.com/i",
        client_id="demo_client_id",
        client_secret="demo_client_secret",
        redirect_uri="https://example.org/oauth/callback",
        scope=["tweet.read", "tweet.write", "users.read", "offline.access"],
    )
    oauth2_client = Client(base_url=base_url, oauth2_auth=oauth2)
    auth_url = oauth2.get_authorization_url(state="state_token_abc")
    _require("code_challenge_method=S256" in auth_url, "PKCE S256 URL expected")
    token = oauth2.exchange_code("sample_auth_code")
    _require(bool(token.get("access_token")), "Exchanged access token expected")
    me = oauth2_client.users.get_me()
    _require(me is not None and me.data is not None, "OAuth2 get_me should succeed")
    oauth2_client.refresh_token()

    # 1c. OAuth 1.0a User Context (HMAC-SHA1)
    oauth1 = OAuth1(
        api_key="consumer_key",
        api_secret="consumer_secret",
        callback="oob",
        access_token="user_access_token",
        access_token_secret="user_access_secret",
        base_url=base_url,
    )
    oauth1_client = Client(base_url=base_url, auth=oauth1)
    created = oauth1_client.posts.create(
        body=schemas.CreatePostsRequest(text="Posting with OAuth 1.0a!")
    )
    _require(created is not None, "OAuth1 post creation should succeed")


def run_posts_and_search_examples(client: Client) -> None:
    """2. Posts, Search, Post Counts & Analytics (PostsClient)."""
    created = client.posts.create(
        body=schemas.CreatePostsRequest(
            text="Shipping Python & TypeScript SDKs on X API v2!",
            reply_settings="following",
        )
    )
    _require(created is not None, "create post")

    post = client.posts.get_by_id(
        "1234567890",
        post_fields=["created_at", "public_metrics", "author_id"],
        expansions=["author_id"],
        user_fields=["username", "verified"],
    )
    _require(post is not None, "get_by_id")
    client.posts.get_by_ids(ids=["1234567890", "1234567891"])

    # Paginated recent search & full-archive search
    pages = list(
        itertools.islice(
            client.posts.search_recent(
                query="from:XDevelopers -is:retweet",
                max_results=10,
            ),
            2,
        )
    )
    _require(len(pages) >= 1, "search_recent pages")
    _first_if_generator(client.posts.search_all(query="xdk sdk", max_results=10))

    # Post counts, analytics & engagement lookups
    _first_if_generator(client.posts.get_counts_recent(query="xdk", granularity="day"))
    _first_if_generator(client.posts.get_counts_all(query="xdk"))
    _first_if_generator(
        client.posts.get_analytics(
            ids=["1234567890"],
            start_time="2025-01-01T00:00:00Z",
            end_time="2025-01-07T00:00:00Z",
        )
    )
    _first_if_generator(client.posts.get_liking_users("1234567890"))
    _first_if_generator(client.posts.get_reposted_by("1234567890"))
    _first_if_generator(client.posts.get_quoted("1234567890"))
    client.posts.hide_reply("1234567890", body=schemas.HidePostsReplyRequest(hidden=True))
    client.posts.delete("1234567890")


def run_users_and_bookmarks_examples(client: Client) -> None:
    """3. Users, Timelines, Social Graph & Bookmarks (UsersClient)."""
    me = client.users.get_me(user_fields=["created_at", "description"])
    my_id = "2244994945"
    if me and me.data is not None:
        my_id = getattr(me.data, "id", None) or (
            me.data.get("id") if isinstance(me.data, dict) else "2244994945"
        )

    client.users.get_by_username("XDevelopers")
    client.users.get_by_usernames(usernames=["XDevelopers", "X"])
    client.users.get_by_id(my_id)
    client.users.get_by_ids(ids=[my_id, "783214"])
    _first_if_generator(client.users.search(query="developer platform"))

    # Timelines & mentions with Cursor pagination
    timeline_items = list(Cursor(client.users.get_posts, my_id, max_results=10).items(limit=3))
    _require(len(timeline_items) >= 1, "user posts items")
    _first_if_generator(client.users.get_mentions(my_id))
    _first_if_generator(client.users.get_timeline(my_id))

    # Social graph: follow, followers, likes, reposts, blocks, mutes
    client.users.follow_user(my_id, body=schemas.FollowUserRequest(target_user_id="783214"))
    _first_if_generator(client.users.get_followers(my_id))
    _first_if_generator(client.users.get_following(my_id))
    client.users.like_post(my_id, body=schemas.LikePostRequest(tweet_id="1234567890"))
    client.users.unlike_post(my_id, "1234567890")
    client.users.repost_post(my_id, body=schemas.RepostPostRequest(tweet_id="1234567890"))
    client.users.unrepost_post(my_id, "1234567890")
    client.users.id_block(my_id, body=schemas.UsersIdBlockRequest(target_user_id="99999"))
    client.users.id_unblock(my_id, "99999")
    client.users.mute_user(my_id, body=schemas.MuteUserRequest(target_user_id="99999"))
    client.users.unmute_user(my_id, "99999")
    client.users.unfollow_user(my_id, "783214")

    # Bookmarks & bookmark folders
    bm = client.users.create_bookmark(
        my_id, body=schemas.CreateUsersBookmarkRequest(tweet_id="1234567890")
    )
    _require(bm is not None, "create_bookmark")
    _first_if_generator(client.users.get_bookmarks(my_id))
    client.users.create_bookmark_folder(
        my_id, body=schemas.CreateUsersBookmarkFolderRequest(name="SDK Docs")
    )
    _first_if_generator(client.users.get_bookmark_folders(my_id))
    client.users.delete_bookmark(my_id, "1234567890")


def run_streaming_examples(client: Client) -> None:
    """4. Real-Time Filtered & Sample Streaming (StreamClient)."""
    rule = schemas.UpdateRulesAdd(
        value="xdk (python OR typescript) -is:retweet", tag="xdk-mentions"
    )
    client.stream.update_rules(body=schemas.UpdateRulesRequest(add=[rule]))
    _first_if_generator(client.stream.get_rules())
    client.stream.get_rule_counts()

    stream_cfg = StreamConfig(max_retries=0, initial_backoff=0.02, max_backoff=0.1)
    events = list(
        itertools.islice(
            client.stream.posts(
                tweet_fields=["created_at", "author_id"],
                stream_config=stream_cfg,
            ),
            2,
        )
    )
    _require(len(events) >= 1, "Filtered stream should emit events")

    sample_events = list(
        itertools.islice(client.stream.posts_sample(stream_config=stream_cfg), 1)
    )
    _require(len(sample_events) == 1, "Sample stream should emit event")


def run_media_upload_examples(client: Client) -> None:
    """5. Media Upload, Chunked Large Video & Metadata (MediaClient)."""
    base64_chunk = base64.b64encode(b"fake_mp4_segment_bytes").decode("ascii")

    client.media.upload(
        body=schemas.MediaUploadRequest(media=base64_chunk, media_category="tweet_image")
    )

    # Chunked video upload lifecycle (supports >2 GiB 64-bit total_bytes)
    init = client.media.initialize_upload(
        body=schemas.InitializeMediaUploadRequest(
            total_bytes=3_221_225_472,  # 3 GiB
            media_type="video/mp4",
            media_category="tweet_video",
        )
    )
    media_id = "1889990001"
    if init and init.data is not None:
        media_id = getattr(init.data, "id", None) or "1889990001"

    client.media.append_upload(
        media_id,
        body=schemas.AppendMediaUploadRequest(segment_index=0, media=base64_chunk),
    )
    client.media.finalize_upload(media_id)
    client.media.get_upload_status(media_id=media_id, command="STATUS")

    client.media.create_metadata(
        body=schemas.CreateMediaMetadataRequest(
            id=media_id,
            metadata=schemas.CreateMediaMetadataMetadata(),
        )
    )
    client.media.create_subtitles(
        body=schemas.CreateMediaSubtitlesRequest(
            id=media_id,
            media_category="TweetVideo",
            subtitles=schemas.CreateMediaSubtitlesSubtitles(),
        )
    )
    client.media.get_by_keys(media_keys=[f"3_{media_id}"])
    _first_if_generator(
        client.media.get_analytics(
            media_keys=[f"3_{media_id}"],
            start_time="2025-01-01T00:00:00Z",
            end_time="2025-01-07T00:00:00Z",
        )
    )
    _first_if_generator(client.media.get_library_categories())


def run_direct_messages_and_chat_examples(client: Client) -> None:
    """6. Direct Messages & Encrypted XChat (DirectMessagesClient, ChatClient)."""
    client.direct_messages.create_by_participant_id(
        "783214",
        body=schemas.CreateDirectMessagesByParticipantIdRequest(text="Hey from XDK Python!"),
    )
    client.direct_messages.create_conversation(
        body=schemas.CreateDirectMessagesConversationRequest(
            conversation_type="Group",
            participant_ids=["783214", "2244994945"],
            message=schemas.CreateDirectMessagesConversationMessage(text="Starting group chat!"),
        )
    )
    client.direct_messages.create_by_conversation_id(
        "conv_1",
        body=schemas.CreateDirectMessagesByConversationIdRequest(text="Welcome to the group DM!"),
    )
    _first_if_generator(client.direct_messages.get_events(max_results=10))
    dm_media = client.direct_messages.dm_conversations_media_download("dm_1", "m_1", "r_1")
    _require(isinstance(dm_media, bytes) and len(dm_media) > 0, "DM media binary download")
    client.direct_messages.delete_events("ev_1")

    # Encrypted XChat & public keys
    client.users.get_public_keys(ids=["2244994945"])
    client.chat.get_settings()
    client.chat.send_message(
        "chat_conv_1",
        body=schemas.SendChatMessageRequest(
            encoded_message_create_event="base64_encrypted_event",
            message_id="msg_001",
        ),
    )
    _first_if_generator(client.chat.get_conversation_events("chat_conv_1"))
    client.chat.media_upload_initialize(
        body=schemas.ChatMediaUploadInitializeRequest(
            conversation_id="chat_conv_1", total_bytes=1_048_576
        )
    )
    client.chat.media_upload_append(
        "upload_1",
        body=schemas.ChatMediaUploadAppendRequest(
            conversation_id="chat_conv_1",
            media_hash_key="hash_1",
            segment_index=0,
            media="Y2hhdF9tZWRpYQ==",
        ),
    )
    chat_bytes = client.chat.media_download("chat_conv_1", "hash_1")
    _require(isinstance(chat_bytes, bytes) and len(chat_bytes) > 0, "XChat media download")


