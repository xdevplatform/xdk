def run_webhooks_and_automation_examples(client: Client) -> None:
    """9. Webhooks, Account Activity, Activity Subscriptions, Bots, Connections & Account."""
    client.webhooks.create(
        body=schemas.CreateWebhooksRequest(url="https://webhooks.example.org/x/events")
    )
    client.webhooks.get()
    client.webhooks.validate("wh_1")
    client.webhooks.create_stream_link("wh_1")
    client.webhooks.get_stream_links()
    client.webhooks.create_webhook_replay_job(
        body=schemas.CreateWebhookReplayJobRequest(
            webhook_id="wh_1",
            from_date="202501150000",
            to_date="202501150100",
        )
    )

    client.account_activity.create_subscription("wh_1", body={})
    client.account_activity.get_subscriptions("wh_1")
    client.account_activity.get_subscription_count()
    client.account_activity.validate_subscription("wh_1")
    client.account_activity.delete_subscription("wh_1", "2244994945")

    client.activity.create_subscription(
        body=schemas.CreateActivitySubscriptionRequest(
            event_type="post.create",
            filter=schemas.CreateActivitySubscriptionFilter(user_id="2244994945"),
            webhook_id="wh_1",
            tag="acct-sub",
        )
    )
    _first_if_generator(client.activity.get_subscriptions())
    client.activity.update_subscription(
        "sub_1", body=schemas.UpdateActivitySubscriptionRequest(tag="updated-tag")
    )
    client.activity.delete_subscription("sub_1")
    client.webhooks.delete("wh_1")

    client.bots.create_bot(
        body=schemas.CreateBotRequest(
            display_name="XDK Helper Bot",
            handle="xdk_helper_bot",
        )
    )
    _first_if_generator(client.bots.get())
    client.bots.rotate_bot_token("bot_1", body=schemas.RotateBotTokenRequest())
    client.bots.revoke_bot_token("bot_1")
    client.bots.delete_bot("bot_1")

    _first_if_generator(client.connections.get_connection_history())
    client.connections.delete_by_endpoint("posts-stream")
    client.account.get_developer()
    client.account.ensure(body=schemas.EnsureAccountRequest(metadata="{}"))


def run_compliance_and_usage_examples(client: Client) -> None:
    """10. Batch Compliance, API Usage & OpenAPI Spec Introspection."""
    client.compliance.create_jobs(
        body=schemas.CreateComplianceJobsRequest(
            type="tweets",
            name="nightly-compliance-sync",
            resumable=True,
        )
    )
    client.compliance.get_jobs(type="tweets", status="in_progress")
    ids_payload = b"1234567890\n1234567891\n"
    client.compliance.upload_job_submission("job_1", "upload_tok", body=ids_payload)
    client.compliance.get_jobs_by_id("job_1")
    results = client.compliance.download_job_results("job_1", "download_tok")
    _require(isinstance(results, bytes) and len(results) > 0, "Compliance binary download")
    client.compliance.delete_jobs_by_id("job_1")

    client.usage.get(days=7)
    client.usage.get_credits()

    spec = client.general.get_open_api_spec()
    _require(spec is not None, "OpenAPI spec response")


def run_all(base_url: str, client: Client) -> Dict[str, int]:
    """Run all 10 X API v2 workflow suites (covering all 24 endpoint groups) and return durations in ms."""
    suites: Tuple[Tuple[str, Callable[[], None]], ...] = (
        ("01_authentication_flows", lambda: run_authentication_examples(base_url)),
        ("02_posts_and_search", lambda: run_posts_and_search_examples(client)),
        ("03_users_social_and_bookmarks", lambda: run_users_and_bookmarks_examples(client)),
        ("04_realtime_streaming", lambda: run_streaming_examples(client)),
        ("05_media_upload_and_metadata", lambda: run_media_upload_examples(client)),
        ("06_direct_messages_and_xchat", lambda: run_direct_messages_and_chat_examples(client)),
        ("07_lists_communities_spaces_calls", lambda: run_communities_spaces_lists_examples(client)),
        ("08_trends_news_articles_notes", lambda: run_discovery_and_notes_examples(client)),
        ("09_webhooks_activity_bots_account", lambda: run_webhooks_and_automation_examples(client)),
        ("10_compliance_usage_and_openapi", lambda: run_compliance_and_usage_examples(client)),
    )

    timings: Dict[str, int] = {}
    for name, fn in suites:
        started = time.perf_counter()
        fn()
        timings[name] = int((time.perf_counter() - started) * 1000)
    return timings


def main() -> None:
    live_base_url = os.environ.get("X_API_BASE_URL", "").strip()
    if live_base_url:
        bearer = os.environ.get("X_BEARER_TOKEN", "demo_bearer")
        access = os.environ.get("X_ACCESS_TOKEN", bearer)
        client = Client(base_url=live_base_url, bearer_token=bearer, access_token=access)
        results = run_all(live_base_url, client)
        print(f"Completed {len(results)} XDK Python use-case suites against {live_base_url}: {results}")
        return

    with MockXApiServer() as server:
        oauth1 = OAuth1(
            api_key="demo_ck",
            api_secret="demo_cs",
            callback="oob",
            access_token="demo_at",
            access_token_secret="demo_ats",
            base_url=server.base_url,
        )
        client = Client(
            base_url=server.base_url,
            bearer_token="demo_bearer_token",
            access_token="demo_oauth2_user_token",
            auth=oauth1,
        )
        results = run_all(server.base_url, client)
        print(
            f"Completed all {len(results)} XDK Python use-case suites "
            f"({len(server.requests)} HTTP calls) against local X API simulator:"
        )
        for name, duration_ms in results.items():
            print(f"  [PASS] {name} ({duration_ms} ms)")


if __name__ == "__main__":
    main()
