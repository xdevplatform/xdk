/**
 * Runs all 10 X API v2 workflow suites (covering all 24 endpoint groups) and returns durations in ms.
 */
export async function runAll(baseUrl: string, client: Client): Promise<Record<string, number>> {
  const suites: Array<[string, () => Promise<void>]> = [
    ['01_authentication_flows', () => runAuthenticationExamples(baseUrl)],
    ['02_posts_and_search', () => runPostsAndSearchExamples(client)],
    ['03_users_social_and_bookmarks', () => runUsersAndBookmarksExamples(client)],
    ['04_realtime_streaming', () => runStreamingExamples(client)],
    ['05_media_upload_and_metadata', () => runMediaUploadExamples(client)],
    ['06_direct_messages_and_xchat', () => runDirectMessagesAndChatExamples(client)],
    ['07_lists_communities_spaces_calls', () => runCommunitiesSpacesListsExamples(client)],
    ['08_trends_news_articles_notes', () => runDiscoveryAndNotesExamples(client)],
    ['09_webhooks_activity_bots_account', () => runWebhooksAndAutomationExamples(client)],
    ['10_compliance_usage_and_openapi', () => runComplianceAndUsageExamples(client)],
  ];

  const timings: Record<string, number> = {};
  for (const [name, fn] of suites) {
    const start = performance.now();
    await fn();
    timings[name] = Math.round(performance.now() - start);
  }
  return timings;
}

async function main(): Promise<void> {
  const liveBaseUrl = (process.env.X_API_BASE_URL || '').trim();
  if (liveBaseUrl) {
    const bearer = process.env.X_BEARER_TOKEN || 'demo_bearer';
    const access = process.env.X_ACCESS_TOKEN || bearer;
    const client = new Client({ baseUrl: liveBaseUrl, bearerToken: bearer, accessToken: access });
    const results = await runAll(liveBaseUrl, client);
    console.log(`Completed ${Object.keys(results).length} XDK TypeScript use-case suites:`, results);
    return;
  }

  const server = await MockXApiServer.start();
  try {
    const oauth1 = new OAuth1({
      apiKey: 'demo_ck',
      apiSecret: 'demo_cs',
      accessToken: 'demo_at',
      accessTokenSecret: 'demo_ats',
      baseUrl: server.baseUrl,
    });
    const client = new Client({
      baseUrl: server.baseUrl,
      bearerToken: 'demo_bearer_token',
      accessToken: 'demo_oauth2_user_token',
      oauth1,
    });
    const results = await runAll(server.baseUrl, client);
    console.log(
      `Completed all ${Object.keys(results).length} XDK TypeScript use-case suites (${server.requests.length} HTTP calls) against local X API simulator:`
    );
    for (const [name, ms] of Object.entries(results)) {
      console.log(`  [PASS] ${name} (${ms} ms)`);
    }
  } finally {
    await server.close();
  }
}

const entryScript = process.argv[1] || '';
if (/(?:^|[\\/])use_cases\.(?:ts|js|mjs|cjs)$/.test(entryScript)) {
  main().catch(err => {
    console.error(err);
    process.exit(1);
  });
}
