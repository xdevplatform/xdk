  const first = iterator.next();
  return { controller, stream, iterator, first };
};

const nextTick = () => new Promise(resolve => setTimeout(resolve, 0));

describe('EventDrivenStream async iterator', () => {
  afterEach(() => {
    jest.restoreAllMocks();
  });

  it('yields every queued event when the stream closes right after the data', async () => {
    const { controller, iterator, first } = await connect();

    // Three posts arrive in one chunk and the server ends the response.
    controller.enqueue(encoder.encode(NDJSON_3_POSTS));
    controller.close();

