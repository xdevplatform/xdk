import { describe, it, expect, afterEach, jest } from '@jest/globals';
import { EventDrivenStream, StreamIdleTimeoutError } from '../src/stream/event_driven_stream.js';

const encoder = new TextEncoder();

const NDJSON_3_POSTS = [1, 2, 3]
  .map(id => JSON.stringify({ data: { id: String(id), text: `post ${id}` } }))
  .join('\n') + '\n';

const connect = async () => {
  let controller!: ReadableStreamDefaultController<Uint8Array>;
  const source = new ReadableStream<Uint8Array>({
    start(c) {
      controller = c;
    },
  });
  const stream = new EventDrivenStream();
  await stream.connect(source);
  const iterator = stream[Symbol.asyncIterator]();
  const first = iterator.next();
  return { controller, stream, iterator, first };
};

const nextTick = () => new Promise(resolve => setTimeout(resolve, 0));
const sleep = (ms: number) => new Promise(resolve => setTimeout(resolve, ms));

const controllableSource = () => {
  let controller!: ReadableStreamDefaultController<Uint8Array>;
  let cancelled = false;
  const source = new ReadableStream<Uint8Array>({
    start(c) {
      controller = c;
    },
    cancel() {
      cancelled = true;
    },
  });
  return { source, controller, wasCancelled: () => cancelled };
};

describe('EventDrivenStream async iterator', () => {
  afterEach(() => {
    jest.restoreAllMocks();
  });

  it('yields every queued event when the stream closes right after the data', async () => {
    const { controller, iterator, first } = await connect();

    controller.enqueue(encoder.encode(NDJSON_3_POSTS));
    controller.close();

    const ids: string[] = [];
    let result = await first;
    while (!result.done) {
      ids.push(result.value.data.id);
      result = await iterator.next();
    }

    expect(ids).toEqual(['1', '2', '3']);
  });

  it('yields every queued event before surfacing a stream error', async () => {
    jest.spyOn(console, 'error').mockImplementation(() => {});
    const { controller, iterator, first } = await connect();

    controller.enqueue(encoder.encode(NDJSON_3_POSTS));
    await nextTick();
    controller.error(new Error('connection reset'));

    const ids: string[] = [];
    let thrown: unknown = null;
    try {
      let result = await first;
      while (!result.done) {
        ids.push(result.value.data.id);
        result = await iterator.next();
      }
    } catch (error) {
      thrown = error;
    }

    expect(ids).toEqual(['1', '2', '3']);
    expect(thrown).toBeInstanceOf(Error);
    expect((thrown as Error).message).toBe('connection reset');
  });

  it('completes cleanly without hanging when a fast stream emits and closes before iteration begins', async () => {
    const preclosedWithData = new ReadableStream<Uint8Array>({
      start(c) {
        c.enqueue(encoder.encode(NDJSON_3_POSTS));
        c.close();
      },
    });
    const stream = new EventDrivenStream();
    await stream.connect(preclosedWithData);
    // Allow startReading() microtasks to finish completely before attaching asyncIterator
    await new Promise(resolve => setTimeout(resolve, 20));

    const ids: string[] = [];
    for await (const ev of stream) {
      ids.push(ev.data.id);
    }
    expect(ids).toEqual(['1', '2', '3']);

    const preclosedEmpty = new ReadableStream<Uint8Array>({
      start(c) {
        c.close();
      },
    });
    const emptyStream = new EventDrivenStream();
    await emptyStream.connect(preclosedEmpty);
    await new Promise(resolve => setTimeout(resolve, 20));

    const emptyIds: string[] = [];
    for await (const ev of emptyStream) {
      emptyIds.push(ev.data.id);
    }
    expect(emptyIds).toEqual([]);
  });

  it('cancels an in-flight reconnected stream when close() is called mid-reconnect', async () => {
    jest.spyOn(console, 'error').mockImplementation(() => {});
    let firstController!: ReadableStreamDefaultController<Uint8Array>;
    const firstSource = new ReadableStream<Uint8Array>({
      start(c) {
        firstController = c;
      },
    });

    let resolveReconnect!: (s: ReadableStream<Uint8Array>) => void;
    let factoryEnteredResolve!: () => void;
    const factoryEntered = new Promise<void>(resolve => {
      factoryEnteredResolve = resolve;
    });
    let leakedStreamCancelled = false;

    const stream = new EventDrivenStream({
      autoReconnect: true,
      maxReconnectAttempts: 3,
      reconnectDelayMs: 1,
      reconnectFactory: () => {
        factoryEnteredResolve();
        return new Promise<ReadableStream<Uint8Array>>(resolve => {
          resolveReconnect = resolve;
        });
      },
    });

    await stream.connect(firstSource);
    const errors: unknown[] = [];
    stream.on('error', err => errors.push(err));

    const iterPromise = (async () => {
      const items: unknown[] = [];
      for await (const item of stream) {
        items.push(item);
      }
      return items;
    })();

    // Trigger reconnect
    firstController.error(new Error('transient disconnect'));
    await factoryEntered;

    // Close stream while reconnectFactory is still in flight
    stream.close();

    // Now resolve the in-flight reconnectFactory; EventDrivenStream must cancel it immediately
    const replacementStream = new ReadableStream<Uint8Array>({
      cancel() {
        leakedStreamCancelled = true;
      },
    });
    resolveReconnect(replacementStream);

    const collected = await iterPromise;
    await new Promise(resolve => setTimeout(resolve, 10));
    expect(collected).toEqual([]);
    expect(leakedStreamCancelled).toBe(true);
    expect(errors).toEqual([]);
  });
});

describe('EventDrivenStream keep-alive and idle timeout', () => {
  afterEach(() => {
    jest.restoreAllMocks();
  });

  it('emits keepAlive for the bare-newline heartbeat', async () => {
    const { source, controller } = controllableSource();
    const stream = new EventDrivenStream();
    const keepAlives: unknown[] = [];
    stream.on('keepAlive', (event: unknown) => keepAlives.push(event));
    await stream.connect(source);

    controller.enqueue(encoder.encode('\r\n\n'));
    await sleep(10);
    stream.close();

    expect(keepAlives).toEqual([{ data: null }, { data: null }]);
  });

  it('reconnects when a connection goes silent without closing', async () => {
    const first = controllableSource();
    const replacement = new ReadableStream<Uint8Array>({
      start(c) {
        c.enqueue(encoder.encode(NDJSON_3_POSTS));
        c.close();
      },
    });
    const stream = new EventDrivenStream({
      autoReconnect: true,
      reconnectDelayMs: 1,
      idleTimeoutMs: 50,
      reconnectFactory: async () => replacement,
    });
    const reconnects: Array<{ error?: Error }> = [];
    stream.on('reconnect', (event: { error?: Error }) => reconnects.push(event));
    await stream.connect(first.source);

    // Attach the iterator only after the replacement has delivered and closed
    await sleep(120);

    const ids: string[] = [];
    for await (const ev of stream) {
      ids.push(ev.data.id);
    }

    expect(first.wasCancelled()).toBe(true);
    expect(reconnects).toHaveLength(1);
    expect(reconnects[0].error).toBeInstanceOf(StreamIdleTimeoutError);
    expect(ids).toEqual(['1', '2', '3']);
  });

  it('does not use up reconnect attempts across stalls separated by heartbeats', async () => {
    const sources = [controllableSource(), controllableSource(), controllableSource()];
    let next = 1;
    const stream = new EventDrivenStream({
      autoReconnect: true,
      maxReconnectAttempts: 1,
      reconnectDelayMs: 1,
      idleTimeoutMs: 100,
      reconnectFactory: async () => sources[next++].source,
    });
    const reconnects: Array<{ attempt: number }> = [];
    const errors: unknown[] = [];
    stream.on('reconnect', (event: { attempt: number }) => reconnects.push(event));
    stream.on('error', (event: unknown) => errors.push(event));
    jest.spyOn(console, 'error').mockImplementation(() => {});
    await stream.connect(sources[0].source);

    // Stall at ~100ms, heartbeat on the replacement at 150ms, second stall at ~250ms
    await sleep(150);
    sources[1].controller.enqueue(encoder.encode('\r\n'));
    await sleep(150);
    stream.close();

    expect(reconnects.map(r => r.attempt)).toEqual([1, 1]);
    expect(errors).toEqual([]);
  });

  it('surfaces StreamIdleTimeoutError when auto-reconnect is off', async () => {
    jest.spyOn(console, 'error').mockImplementation(() => {});
    const { source, wasCancelled } = controllableSource();
    const stream = new EventDrivenStream({ idleTimeoutMs: 50 });
    const errors: unknown[] = [];
    stream.on('error', (event: unknown) => errors.push(event));
    await stream.connect(source);

    let thrown: unknown = null;
    try {
      for await (const _ of stream) {
        // no data expected
      }
    } catch (error) {
      thrown = error;
    }

    expect(thrown).toBeInstanceOf(StreamIdleTimeoutError);
    expect(errors).toHaveLength(1);
    expect(wasCancelled()).toBe(true);
  });

  it('stays connected while heartbeats keep arriving', async () => {
    const { source, controller, wasCancelled } = controllableSource();
    const stream = new EventDrivenStream({ idleTimeoutMs: 100 });
    const errors: unknown[] = [];
    stream.on('error', (event: unknown) => errors.push(event));
    await stream.connect(source);

    for (let i = 0; i < 5; i++) {
      await sleep(30);
      controller.enqueue(encoder.encode('\r\n'));
    }

    expect(errors).toEqual([]);
    expect(wasCancelled()).toBe(false);
    stream.close();
  });
});
