import { EventDrivenStream } from '../src/stream/event_driven_stream.js';

const encoder = new TextEncoder();

const NDJSON_3_POSTS = [1, 2, 3]
  .map(id => JSON.stringify({ data: { id: String(id), text: `post ${id}` } }))
  .join('\n') + '\n';

/**
 * Connects a stream to a controllable ReadableStream and starts the async
 * iterator (so its listeners are attached) before any events are produced.
 */
const connect = async () => {
